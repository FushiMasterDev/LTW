# File shell: bao giá trị bằng nháy đơn. Không commit bản đã điền.
# cp file này ra ~/FujiHomestay/production.env và chmod 600 trước khi sửa.
FUJI_HOME="$HOME/FujiHomestay"
# Dùng command -v dotnet để tìm đường dẫn đúng (cần cho LaunchAgent).
DOTNET_BIN='/usr/local/share/dotnet/dotnet'
SQL_CONTAINER='sql-homestay'
DATABASE_NAME='HomestayBooking'
ASPNETCORE_ENVIRONMENT='Production'
ASPNETCORE_URLS='http://127.0.0.1:8080'
AllowedHosts='fuji.example;127.0.0.1;localhost'
ConnectionStrings__Default='Server=127.0.0.1,1433;Database=HomestayBooking;User Id=sa;Password=THAY_MAT_KHAU;TrustServerCertificate=True;Encrypt=True'
Database__AutoMigrate='false'
# Tạo quản trị đúng một lần; XÓA dòng Password sau khi tạo/đổi mật khẩu thành công.
Bootstrap__Administrator__EmployeeCode='QT001'
Bootstrap__Administrator__FullName='Quản trị viên Fuji'
Bootstrap__Administrator__Phone='0900000000'
Bootstrap__Administrator__Email='admin@example.invalid'
Bootstrap__Administrator__Password='THAY_MAT_KHAU_MANH'
# Tài khoản ngân hàng thật phải do chủ dự án điền; ví dụ dưới là giả.
BankAccount__BankCode='MB'
BankAccount__AccountNumber='0000000000'
BankAccount__AccountName='TAI KHOAN VI DU'
BankAccount__WebhookApiKey='THAY_KHOA_NGAU_NHIEN'
BankAccount__QrImageBaseUrl='https://img.vietqr.io/image'
# Cùng URL cho lời nhắc và lời mời đối tác, HTTPS, tối đa 50 ký tự.
Reminders__PublicBaseUrl='https://fuji.example'
Reminders__CustomerDaysBefore='1'
Reminders__SendHour='9'
Reminders__QuietFromHour='21'
DataProtection__KeysPath="$FUJI_HOME/data/App_Data/keys"
ReverseProxy__Enabled='true'
# Các giá trị nghiệp vụ mặc định có thể giữ nguyên.
Booking__HoldMinutes='15'
Booking__ConfirmMinutes='30'
Booking__DepositRate='0.30'
Booking__ChangeMinDaysBefore='3'
Booking__MaxChangesPerBooking='2'
Booking__ChangeWindowDays='90'
Booking__MaxAwaitingPerCustomer='3'
Booking__MaxReceiptRejections='2'
Booking__MaxNights='30'
Booking__ReceiptReviewAlertMinutes='120'
Booking__OfficeStartHour='8'
Booking__OfficeEndHour='17'
Settlements__GraceDays='2'
Settlements__LookbackPeriods='4'
Settlements__GenerateEveryMinutes='60'
Voucher__IssueRate='0.05'
Voucher__MinAmount='50000'
Voucher__MaxAmount='200000'
Voucher__ValidMonths='6'
Voucher__MaxDiscountShareOfCommission='0.20'

# Giảm log SQL lặp mỗi phút khi vận hành.
Logging__LogLevel__Microsoft='Warning'
