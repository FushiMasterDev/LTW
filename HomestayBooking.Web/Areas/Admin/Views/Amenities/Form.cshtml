@model AmenityFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? L["Thêm tiện nghi"] : L["Sửa tiện nghi"];
}
<partial name="_PageHead" model='new PageHeadModel(ViewData["Title"]!.ToString()!, "", "", ShowCreate: false)' />
<partial name="_Breadcrumb" model='new BreadcrumbModel(new BreadcrumbItem[] { new("Tiện nghi", Url.Action("Index")), new(ViewData["Title"]!.ToString()!) })' />
<div class="fx-form-card fx-card">
            <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
                <form-field asp-for="Name" autofocus="true" />
                <form-field asp-for="Icon" placeholder="bi-wifi" hint="@L["Tên class trong"]" />
                <p class="small"><i id="iconPreview" class="bi @(Model.Icon ?? "bi-question-circle")" aria-hidden="true"></i> <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener">Bootstrap Icons</a></p>
                <div class="fx-form-actions">
                    <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang lưu..."]"><i class="bi bi-check2" aria-hidden="true"></i> @L["Lưu"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@L["Hủy"]</a>
                </div>
            </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xem trước biểu tượng khi gõ
        $('#Icon').on('input', function () {
            const icon = /^bi-[a-z0-9-]+$/.test(this.value.trim()) ? this.value.trim() : 'bi-question-circle';
            $('#iconPreview').attr('class', 'bi ' + icon);
        });
    </script>
}
