@model PaginatedList<Amenity>
@{
    ViewData["Title"] = L["Tiện nghi"];
    var counts = (Dictionary<int, int>)ViewBag.HomestayCounts;
    string[] tones = ["tone-sky", "tone-emerald", "tone-violet", "tone-orange", "tone-pink", "tone-teal", "tone-amber", "tone-indigo"];
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Tiện nghi"], "bi-stars", "tone-amber", L["Wifi, bể bơi, BBQ..."]))" />
<partial name="_FilterBar" model='new FilterBarModel("catalog-filter", new FilterField[] { new("q", "Tìm theo tên", ViewData["Query"]?.ToString(), Type: "search") })' />

@{ var rows = new List<TableRow>(); }
@foreach (var entry in Model)
                {
                    var used = counts.GetValueOrDefault(entry.Id);
                    var confirm = used > 0
                        ? L["Xóa \"{0}\"? Tiện nghi đang được {1} homestay sử dụng; thao tác xóa sẽ bị chặn.", entry.Name, used]
                        : L["Xóa \"{0}\"?", entry.Name];
                    Func<dynamic, IHtmlContent> cell0 = @<text><div class="d-flex align-items-center gap-3">
                                <span class="fx-icon-chip @tones[entry.Id % tones.Length]" aria-hidden="true"><i class="bi @(entry.Icon ?? "bi-question-circle")"></i></span>
                                <div>
                                    <div class="fw-semibold">@entry.Name</div>
                                    @if (entry.Icon is not null)
                                    {
                                        <code class="small text-muted d-none d-sm-inline">@entry.Icon</code>
                                    }
                                </div>
                            </div></text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text><span class="fx-count tone-amber">@used</span></text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text><partial name="_RowActions" model="@(new RowActionsModel(entry.Id.ToString(), entry.Name, confirm))" /></text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Tiện nghi", new TableColumn[] { new("Tên tiện nghi"), new("Số homestay", Numeric: true), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
