@model TemporaryEmployeePassword
@{ViewData["Title"]=L["Mật khẩu tạm"];}
<partial name="_PageHead" model='new PageHeadModel("Mật khẩu tạm","","",ShowCreate:false)' />
<div class="fx-card fx-form-card"><p>@Model.Target</p><p>@L["Mật khẩu tạm chỉ hiện một lần. Chuyển riêng cho nhân viên và yêu cầu đổi mật khẩu sau khi đăng nhập."]</p>
<label class="form-label" for="temporary-password">@L["Mật khẩu tạm"]</label><input id="temporary-password" class="form-control mb-3" value="@Model.Password" readonly autocomplete="off" />
<button type="button" class="btn btn-brand" data-copy-employee-password data-copied='@L["Đã sao chép"]' data-copy-failed='@L["Không sao chép được. Hãy chọn và sao chép mật khẩu."]'>@L["Sao chép mật khẩu"]</button>
<a asp-action="Index" class="btn btn-outline-secondary">@L["Tài khoản nhân viên"]</a><p class="mt-3" aria-live="polite" data-copy-status></p></div>
@section Scripts { <script src="~/js/components/employee-password.js" asp-append-version="true"></script> }
