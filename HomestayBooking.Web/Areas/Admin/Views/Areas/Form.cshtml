@model AreaFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? L["Thêm khu vực"] : L["Sửa khu vực"];
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <a asp-action="Index" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left" aria-hidden="true"></i> @L["Khu vực"]</a>
        <div class="card-soft card-accent-top tone-sky p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="icon-chip" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
            </div>
            <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Province" class="form-label"></label>
                    <input asp-for="Province" class="form-control" />
                    <span asp-validation-for="Province" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="AreaGroup" class="form-label"></label>
                    <select asp-for="AreaGroup" class="form-select">
                        @foreach (var g in Enum.GetValues<AreaGroup>())
                        {
                            <option value="@g">@L[g.DisplayName()]</option>
                        }
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang lưu..."]"><i class="bi bi-check2" aria-hidden="true"></i> @L["Lưu"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@L["Hủy"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
