@model PaginatedList<Area>
@{
    ViewData["Title"] = L["Khu vực"];
    var counts = (Dictionary<int, int>)ViewBag.HomestayCounts;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Khu vực"], "bi-geo-alt", "tone-sky", L["Quận, huyện có homestay"]))" />
<partial name="_CatalogSearch" />

@{ var rows = new List<TableRow>(); }
@foreach (var entry in Model)
                {
                    Func<dynamic, IHtmlContent> cell0 = @<text>@entry.Name</text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text>@entry.Province</text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text>@L[entry.AreaGroup.DisplayName()]</text>;
                        Func<dynamic, IHtmlContent> cell3 = @<text><span class="fx-count tone-sky">@counts.GetValueOrDefault(entry.Id)</span></text>;
                        Func<dynamic, IHtmlContent> cell4 = @<text><partial name="_RowActions" model="@(new RowActionsModel(entry.Id.ToString(), entry.Name, L["Xóa \"{0}\"?", entry.Name]))" /></text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!), cell3(null!), cell4(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Khu vực", new TableColumn[] { new("Tên khu vực"), new("Tỉnh/thành"), new("Nhóm khu vực"), new("Số homestay", Numeric: true), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
