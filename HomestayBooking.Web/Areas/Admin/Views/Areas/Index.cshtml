@model PaginatedList<Area>
@{
    ViewData["Title"] = L["Khu vực"];
    var counts = (Dictionary<int, int>)ViewBag.HomestayCounts;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Khu vực"], "bi-geo-alt", "tone-sky", L["Quận, huyện có homestay"]))" />
<partial name="_SearchBar" />

<div class="card-soft overflow-hidden">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th scope="col">@L["Tên khu vực"]</th>
                    <th scope="col" class="d-none d-md-table-cell">@L["Tỉnh/thành"]</th>
                    <th scope="col" class="d-none d-md-table-cell">@L["Nhóm khu vực"]</th>
                    <th scope="col" class="text-end d-none d-sm-table-cell">@L["Số homestay"]</th>
                    <th scope="col" class="text-end">@L["Thao tác"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="d-none d-md-table-cell">@item.Province</td>
                        <td class="d-none d-md-table-cell">@L[item.AreaGroup.DisplayName()]</td>
                        <td class="text-end d-none d-sm-table-cell"><span class="count-pill tone-sky">@counts.GetValueOrDefault(item.Id)</span></td>
                        <td class="text-end">
                            <partial name="_RowActions" model="@(new RowActionsModel(item.Id.ToString(), item.Name, L["Xóa \"{0}\"?", item.Name]))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" />
    }
</div>
<partial name="_Pager" model="Model" />
