@model PaginatedList<RoomCategory>
@{
    ViewData["Title"] = L["Loại phòng"];
    var counts = (Dictionary<int, int>)ViewBag.RoomCounts;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Loại phòng"], "bi-grid-3x3-gap", "tone-emerald", L["Phòng đôi, gia đình, nguyên căn..."]))" />
<partial name="_CatalogSearch" />

@{ var rows = new List<TableRow>(); }
@foreach (var entry in Model)
                {
                    Func<dynamic, IHtmlContent> cell0 = @<text>@entry.Name</text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text><span class="fx-count tone-emerald">@counts.GetValueOrDefault(entry.Id)</span></text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text><partial name="_RowActions" model="@(new RowActionsModel(entry.Id.ToString(), entry.Name, L["Xóa \"{0}\"?", entry.Name]))" /></text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Loại phòng", new TableColumn[] { new("Tên loại phòng"), new("Đang dùng", Numeric: true), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
