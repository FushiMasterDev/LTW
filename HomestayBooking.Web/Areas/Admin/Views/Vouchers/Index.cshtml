@using HomestayBooking.Web.Identity
@using HomestayBooking.Web.Services
@model PaginatedList<VoucherRow>
@{
    ViewData["Title"] = L["Voucher"];
    var selected = ViewData["Status"] as VoucherStatus?;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Voucher"], "bi-ticket-perforated", "tone-pink", L["Voucher xin lỗi khách khi Fuji làm hỏng đơn. Mỗi đơn dùng voucher chỉ giảm tối đa 20% hoa hồng của Fuji."], ShowCreate: true))" />

<partial name="_FilterBar" model='new FilterBarModel("voucher-filter", new FilterField[] {
    new("status", "Trạng thái", Options: new[] { new SelectListItem(L["Mọi trạng thái"], "") }.Concat(Enum.GetValues<VoucherStatus>().Select(v => new SelectListItem(L[v.DisplayName()], v.ToString(), v == selected))).ToArray()),
    new("q", "Tìm theo mã, tên hoặc SĐT khách", ViewData["Query"]?.ToString(), Type: "search") })' />

@{ var rows = new List<TableRow>(); }
@foreach (var v in Model)
                {
                    Func<dynamic, IHtmlContent> cell0 = @<text>@v.Code</text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text>@v.CustomerName<div class="small text-muted">@PhoneNumberNormalizer.ToNational(v.CustomerPhone)</div></text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text><money value="@v.Balance" /> / <money value="@v.Amount" />
                            <div class="small text-muted">@L["Đã dùng cho {0} đơn", v.UsedCount]</div></text>;
                        Func<dynamic, IHtmlContent> cell3 = @<text>@v.ExpiresOn.ToString("dd/MM/yyyy")</text>;
                        Func<dynamic, IHtmlContent> cell4 = @<text>@v.Reason
                            @if (v.SourceBookingCode is not null)
                            {
                                <div class="text-muted">@L["Đơn gốc"]: <span class="fx-code">@v.SourceBookingCode</span></div>
                            }
                            <div class="text-muted">@L["Cấp bởi {0}, {1}", v.IssuedBy, VietnamTime.ToLocal(v.IssuedAt).ToString("dd/MM/yyyy")]</div></text>;
                        Func<dynamic, IHtmlContent> cell5 = @<text><status-badge value="@v.Status" /></text>;
                        Func<dynamic, IHtmlContent> cell6 = @<text>@if (v.Status is VoucherStatus.Active or VoucherStatus.UsedUp)
                            {
                                <form asp-action="Revoke" asp-route-id="@v.Id" method="post" data-confirm="@L["Thu hồi voucher {0}?", v.Code]">
                                    <input type="hidden" name="reason" value="Quản lý thu hồi" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">@L["Thu hồi"]</button>
                                </form>
                            }</text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!), cell3(null!), cell4(null!), cell5(null!), cell6(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Voucher", new TableColumn[] { new("Mã voucher"), new("Khách hàng"), new("Số dư / Giá trị", Numeric: true), new("Hạn dùng"), new("Lý do"), new("Trạng thái"), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
