@using HomestayBooking.Web.Services
@model IReadOnlyList<HomestayReport>
@{var rows=new List<TableRow>();foreach(var h in Model){rows.Add(new(new IHtmlContent[] {new HtmlContentBuilder().Append(h.Name),new HtmlContentBuilder().Append(h.Rating?.ToString("N1") ?? "—"),new HtmlContentBuilder().Append(h.ReviewCount.ToString("N0")),new HtmlContentBuilder().Append(h.AverageConfirmMinutes?.ToString("N1") ?? "—"),new HtmlContentBuilder().Append(h.ConfirmWithinThirtyPercent?.ToString("N1")+ (h.ConfirmWithinThirtyPercent.HasValue ? "%":"—"))}));}
var incidents=Model.SelectMany(h=>h.Incidents).ToArray();var months=incidents.Select(i=>(i.Year,i.Month)).Distinct().OrderBy(m=>m.Year).ThenBy(m=>m.Month).ToArray();
var incidentRows=months.Select(m=>new TableRow(new IHtmlContent[] {new HtmlContentBuilder().Append($"{m.Month:00}/{m.Year}"),new HtmlContentBuilder().Append(incidents.Where(i=>i.Year==m.Year && i.Month==m.Month).Sum(i=>i.Reported).ToString("N0")),new HtmlContentBuilder().Append(incidents.Where(i=>i.Year==m.Year && i.Month==m.Month).Sum(i=>i.Replaced).ToString("N0"))})).ToArray();}
<div class="row g-3 mb-4"><div class="col-sm-6"><partial name="_StatCard" model='new StatCardModel("Homestay trong báo cáo",Model.Count.ToString("N0"),"houses")' /></div><div class="col-sm-6"><partial name="_StatCard" model='new StatCardModel("Lượt đánh giá",Model.Sum(h=>h.ReviewCount).ToString("N0"),"chat-square-text")' /></div></div>
<partial name="_ReportChart" model='new ReportChartModel("homestays-chart","Điểm đánh giá theo homestay","bar",Model.Select(h=>h.Name).ToArray(),new[] {new ReportChartSeries(L["Điểm đánh giá"],Model.Select(h=>h.Rating).ToArray())},new DataTableModel("Chất lượng homestay",new TableColumn[] {new("Homestay"),new("Điểm",Numeric:true),new("Lượt đánh giá",Numeric:true),new("Phút xác nhận trung bình",Numeric:true),new("Xác nhận trong 30 phút",Numeric:true)},rows))' />
<p class="text-muted">@L["Dấu gạch ngang là chưa có dữ liệu. Biểu đồ sự cố chỉ gồm các tháng có sự cố."]</p>
<partial name="_ReportChart" model='new ReportChartModel("incidents-chart","Sự cố theo tháng","line",months.Select(m=>$"{m.Month:00}/{m.Year}").ToArray(),new[] {
new ReportChartSeries(L["Đã báo trùng phòng"],months.Select(m=>(double?)incidents.Where(i=>i.Year==m.Year && i.Month==m.Month).Sum(i=>i.Reported)).ToArray(),"primary"),
new ReportChartSeries(L["Đã thay thế"],months.Select(m=>(double?)incidents.Where(i=>i.Year==m.Year && i.Month==m.Month).Sum(i=>i.Replaced)).ToArray(),"rose") },new DataTableModel("Sự cố theo tháng",new TableColumn[] {new("Tháng"),new("Đã báo trùng phòng",Numeric:true),new("Đã thay thế",Numeric:true)},incidentRows))' />
