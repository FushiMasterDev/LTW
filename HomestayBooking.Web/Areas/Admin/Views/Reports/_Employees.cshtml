@using HomestayBooking.Web.Services
@model IReadOnlyList<EmployeePerformance>
@{var rows=new List<TableRow>();foreach(var e in Model){Func<dynamic,IHtmlContent> money=@<text><money value="@e.CompletedRoomAmount" /></text>;
rows.Add(new(new IHtmlContent[] {new HtmlContentBuilder().Append(e.Code+" · "+e.Name),new HtmlContentBuilder().Append(e.Created.ToString("N0")),new HtmlContentBuilder().Append(e.Confirmed.ToString("N0")),new HtmlContentBuilder().Append(e.ConversionPercent.ToString("N1")+"%"),money(null!),new HtmlContentBuilder().Append(e.AssignedOpen.ToString("N0")),new HtmlContentBuilder().Append(e.AssignedFinished.ToString("N0"))}));}}
<div class="row g-3 mb-4"><div class="col-sm-6"><partial name="_StatCard" model='new StatCardModel("Nhân viên trong báo cáo",Model.Count.ToString("N0"),"people")' /></div><div class="col-sm-6"><partial name="_StatCard" model='new StatCardModel("Đơn nhân viên tạo",Model.Sum(e=>e.Created).ToString("N0"),"journal-check")' /></div></div>
<p class="text-muted">@L["Tỷ lệ chốt = đơn nhân viên tạo được xác nhận / đơn nhân viên tạo."]</p>
<partial name="_ReportChart" model='new ReportChartModel("employees-chart","Tỷ lệ chốt theo nhân viên (%)","bar",Model.Select(e=>e.Code).ToArray(),new[] {new ReportChartSeries(L["Tỷ lệ chốt (%)"],Model.Select(e=>(double?)e.ConversionPercent).ToArray())},new DataTableModel("Hiệu suất nhân viên",new TableColumn[] {new("Nhân viên"),new("Đơn tạo",Numeric:true),new("Được xác nhận",Numeric:true),new("Tỷ lệ chốt",Numeric:true),new("Tiền phòng hoàn thành",Numeric:true),new("Được giao đang mở",Numeric:true),new("Được giao đã xong",Numeric:true)},rows), HasData:Model.Any(e=>e.Created>0 || e.Confirmed>0 || e.AssignedOpen>0 || e.AssignedFinished>0 || e.CompletedRoomAmount!=0))' />
