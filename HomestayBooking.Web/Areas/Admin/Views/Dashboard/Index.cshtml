@{
    ViewData["Title"] = L["Tổng quan quản trị"];
    var stats = new (string Label, object Value, string Icon, string Tone)[]
    {
        (L["Homestay"], ViewBag.HomestayCount, "bi-houses", "tone-sky"),
        (L["Phòng"], ViewBag.RoomCount, "bi-door-closed", "tone-emerald"),
        (L["Chủ homestay"], ViewBag.OwnerCount, "bi-person-badge", "tone-teal"),
        (L["Nhân viên"], ViewBag.StaffCount, "bi-headset", "tone-orange"),
        (L["Hồ sơ Owner chờ duyệt"], ViewBag.PendingOwnerCount, "bi-person-check", "tone-rose"),
        (L["Đơn chờ xác nhận"], ViewBag.PendingBookingCount, "bi-hourglass-split", "tone-amber"),
    };
    var links = new (string Controller, string Label, string Hint, string Icon, string Tone)[]
    {
        ("Areas", L["Khu vực"], L["Quận, huyện có homestay"], "bi-geo-alt", "tone-sky"),
        ("RoomCategories", L["Loại phòng"], L["Phòng đôi, gia đình, nguyên căn..."], "bi-grid-3x3-gap", "tone-emerald"),
        ("Amenities", L["Tiện nghi"], L["Wifi, bể bơi, BBQ..."], "bi-stars", "tone-amber"),
        ("Holidays", L["Ngày lễ"], L["Ngày áp giá lễ"], "bi-calendar-heart", "tone-rose"),
    };
}
<partial name="_PageHead" model='new PageHeadModel("Tổng quan quản trị", "", "", L["Theo dõi nhanh hệ thống và quản lý danh mục dùng chung."], ShowCreate: false)' />

<div class="row g-3 mb-2">
    @foreach (var s in stats)
    {
        <div class="col-sm-6 col-xl-4">
            <partial name="_StatCard" model="@(new StatCardModel(s.Label, Convert.ToString(s.Value) ?? "0", s.Icon))" />
        </div>
    }
</div>

<div class="row g-4 mt-2">
    <div class="col-lg-6">
        <partial name="_TaskList" model='new TaskListModel("Việc cần xử lý", new TaskListItem[] {
            new("Hồ sơ Owner chờ duyệt", Value: (int)ViewBag.PendingOwnerCount),
            new("Đơn chờ xác nhận", Value: (int)ViewBag.PendingBookingCount) })' />
    </div>
    <div class="col-lg-6">
        <partial name="_TaskList" model='new TaskListModel("Danh mục", links.Select(link => new TaskListItem(link.Label, link.Hint, Url.Action("Index", link.Controller))).ToArray())' />
    </div>
</div>
