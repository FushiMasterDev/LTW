@model PaginatedList<Holiday>
@{
    ViewData["Title"] = L["Ngày lễ"];
    var years = (List<int>)ViewBag.Years;
    var selectedYear = ViewData["Year"] as int?;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Ngày lễ"], "bi-calendar-heart", "tone-rose", L["Đêm rơi vào các ngày này được tính giá ngày lễ."]))" />

<partial name="_FilterBar" model='new FilterBarModel("holiday-filter", new FilterField[] {
    new("year", "Năm", Options: new[] { new SelectListItem(L["Tất cả các năm"], "") }.Concat(years.Select(y => new SelectListItem(y.ToString(), y.ToString(), y == selectedYear))).ToArray()),
    new("q", "Tìm theo tên", ViewData["Query"]?.ToString(), Type: "search") })' />

@{ var rows = new List<TableRow>(); }
@foreach (var entry in Model)
                {
                    var key = entry.Date.ToString("yyyy-MM-dd");
                    var weekend = entry.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                    Func<dynamic, IHtmlContent> cell0 = @<text><div class="d-flex align-items-center gap-3">
                                <span class="fx-icon-chip tone-rose fw-bold" aria-hidden="true">@entry.Date.Day</span>
                                <div>
                                    <div class="fw-semibold">@entry.Date.ToString("d")</div>
                                    <small class="@(weekend ? "text-danger" : "text-muted")">@entry.Date.ToString("dddd")</small>
                                </div>
                            </div></text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text>@entry.Name</text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text><partial name="_RowActions" model="@(new RowActionsModel(key, entry.Name, L["Xóa \"{0}\"?", $"{entry.Name} ({entry.Date:d})"]))" /></text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Ngày lễ", new TableColumn[] { new("Ngày"), new("Tên ngày lễ"), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
