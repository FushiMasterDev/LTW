@model HolidayFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? L["Thêm ngày lễ"] : L["Sửa ngày lễ"];
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <a asp-action="Index" asp-route-year="@Model.Date?.Year" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left" aria-hidden="true"></i> @L["Ngày lễ"]</a>
        <div class="card-soft card-accent-top tone-rose p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="icon-chip" aria-hidden="true"><i class="bi bi-calendar-heart"></i></span>
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
            </div>
            <form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@(Model.IsNew ? null : Model.Date?.ToString("yyyy-MM-dd"))" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Date" class="form-label"></label>
                    @if (Model.IsNew)
                    {
                        <input asp-for="Date" type="date" class="form-control" />
                    }
                    else
                    {
                        <input asp-for="Date" type="date" class="form-control" disabled aria-describedby="dateHelp" />
                        <div id="dateHelp" class="form-text">@L["Ngày không sửa được. Muốn đổi ngày, hãy xóa và thêm mới."]</div>
                    }
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang lưu..."]"><i class="bi bi-check2" aria-hidden="true"></i> @L["Lưu"]</button>
                    <a asp-action="Index" asp-route-year="@Model.Date?.Year" class="btn btn-outline-secondary">@L["Hủy"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
