@model HolidayFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? L["Thêm ngày lễ"] : L["Sửa ngày lễ"];
}
<partial name="_PageHead" model='new PageHeadModel(ViewData["Title"]!.ToString()!, "", "", ShowCreate: false)' />
<partial name="_Breadcrumb" model='new BreadcrumbModel(new BreadcrumbItem[] { new("Ngày lễ", Url.Action("Index")), new(ViewData["Title"]!.ToString()!) })' />
<div class="fx-form-card fx-card">
            <form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@(Model.IsNew ? null : Model.Date?.ToString("yyyy-MM-dd"))" method="post" novalidate>
                @if (Model.IsNew) { <form-field asp-for="Date" type="date" /> }
                else { <form-field asp-for="Date" type="date" disabled="disabled" hint="@L["Ngày không sửa được. Muốn đổi ngày, hãy xóa và thêm mới."]" /> }
                <form-field asp-for="Name" />
                <div class="fx-form-actions">
                    <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang lưu..."]"><i class="bi bi-check2" aria-hidden="true"></i> @L["Lưu"]</button>
                    <a asp-action="Index" asp-route-year="@Model.Date?.Year" class="btn btn-outline-secondary">@L["Hủy"]</a>
                </div>
            </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
