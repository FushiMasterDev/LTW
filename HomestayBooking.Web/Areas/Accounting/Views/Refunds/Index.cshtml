@model PaginatedList<RefundRow>
@{
    ViewData["Title"] = L["Hoàn tiền"];
    var done = (bool)ViewData["Done"]!;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Hoàn tiền"], "bi-arrow-counterclockwise", "tone-sky", L["Đơn hủy hoặc bị homestay từ chối đã chốt số tiền hoàn. Chuyển khoản cho khách rồi ghi lại mã giao dịch."], ShowCreate: false))" />
<partial name="_Tabs" model="@TabsModel.Accounting(User, ViewData["Counts"] as AccountingCounts, ViewContext.RouteData.Values["controller"]?.ToString())" />

<partial name="_FilterBar" model='new FilterBarModel("accounting-refunds-filter", new FilterField[] {
    new("done", "Trạng thái", Options: new[] { new SelectListItem(L["Chờ hoàn"], "false", !done), new SelectListItem(L["Đã hoàn"], "true", done) }),
    new("q", "Tìm theo mã đơn, tên hoặc SĐT khách", ViewData["Query"]?.ToString(), Type: "search") })' />

@{ var rows = new List<TableRow>(); }
@foreach (var r in Model)
                {
                    Func<dynamic, IHtmlContent> cell0 = @<text><span class="fx-code fw-semibold">@r.BookingCode</span>@if (r.SettlementId is int settlementId) { <div><a asp-controller="Settlements" asp-action="Details" asp-route-id="@settlementId">@L["Xem kỳ đối soát"]</a></div> }
                            <div><status-badge value="@r.Status" /></div></text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text>@r.ContactName<div class="small text-muted">@PhoneNumberNormalizer.ToNational(r.ContactPhone) · @r.HomestayName</div></text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text><money value="@r.AmountPaid" /></text>;
                        Func<dynamic, IHtmlContent> cell3 = @<text><money value="@r.RefundAmount" /></text>;
                        Func<dynamic, IHtmlContent> cell4 = @<text>@(r.CancelReason ?? "—")
                            @if (r.CancelledAt is { } at)
                            {
                                <div class="text-muted">@L["Hủy lúc {0}", VietnamTime.ToLocal(at).ToString("HH:mm dd/MM")]</div>
                            }
                            @if (!done && r.DepositTransferContent is not null)
                            {
                                <div class="text-muted">@L["Cọc nhận từ: {0}", r.DepositTransferContent]</div>
                            }</text>;
                        Func<dynamic, IHtmlContent> cell5 = @<text>@if (done)
                            {
                                <div class="small text-nowrap">@r.RefundBankRef</div>
                                <div class="small text-muted text-nowrap">@r.RefundedBy · @(r.RefundedAt is { } rt ? VietnamTime.ToLocal(rt).ToString("dd/MM") : "")</div>
                            }
                            else
                            {
                                <form asp-action="Record" asp-route-id="@r.BookingId" method="post" class="d-flex gap-2 justify-content-end"
                                      data-confirm="@L["Xác nhận đã chuyển hoàn {0:N0}đ cho đơn {1}?", r.RefundAmount, r.BookingCode]">
                                    <label for="ref-@r.BookingId" class="visually-hidden">@L["Mã giao dịch chuyển trả"]</label>
                                    <input id="ref-@r.BookingId" name="bankRef" class="form-control form-control-sm fx-refund-ref" required maxlength="100" placeholder="@L["Mã giao dịch"]" />
                                    <button type="submit" class="btn btn-sm btn-brand text-nowrap">@L["Đã hoàn"]</button>
                                </form>
                            }</text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!), cell3(null!), cell4(null!), cell5(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Hoàn tiền", new TableColumn[] { new("Đơn"), new("Khách"), new("Khách đã chuyển", Numeric: true), new("Cần hoàn", Numeric: true), new("Lý do"), new(done ? "Đã hoàn" : "Ghi nhận") }, rows)' />
<partial name="_Pager" model="Model" />
