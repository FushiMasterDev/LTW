@model PaginatedList<BankTransactionRow>
@{
    ViewData["Title"] = L["Giao dịch ngân hàng"];
    var selected = ViewData["Status"] as BankMatchStatus?;
    var all = (bool)ViewData["All"]!;
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Giao dịch ngân hàng"], "bi-bank", "tone-rose", L["Tiền vào tài khoản MB của Fuji. Mặc định chỉ hiện các khoản cần xử lý tay."], ShowCreate: false))" />
<partial name="_Tabs" model="@TabsModel.Accounting(User, ViewData["Counts"] as AccountingCounts, ViewContext.RouteData.Values["controller"]?.ToString())" />

<partial name="_FilterBar" model='new FilterBarModel("accounting-transactions-filter", new FilterField[] {
    new("status", "Trạng thái", Options: new[] { new SelectListItem(L["Cần xử lý"], "") }.Concat(Enum.GetValues<BankMatchStatus>().Select(v => new SelectListItem(L[v.DisplayName()], v.ToString(), v == selected))).ToArray()),
    new("q", "Tìm theo nội dung, mã đơn, mã giao dịch", ViewData["Query"]?.ToString(), Type: "search"),
    new("all", "Mọi giao dịch", Type: "checkbox", Options: new[] { new SelectListItem(L["Mọi giao dịch"], "true", all) }) })' />

@{ var rows = new List<TableRow>(); }
@foreach (var t in Model)
                {
                    var open = AccountingService.OpenStatuses.Contains(t.MatchStatus);
                    Func<dynamic, IHtmlContent> cell0 = @<text>@VietnamTime.ToLocal(t.TransactionTime).ToString("HH:mm dd/MM/yyyy")
                            <div class="small text-muted text-truncate fx-tx-ref" title="@t.ProviderTransactionId">@t.Provider · @t.ProviderTransactionId</div></text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text><money value="@t.Amount" /></text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text>@(t.TransferContent ?? "—")
                            @if (t.Note is not null)
                            {
                                <div class="text-muted">@t.Note</div>
                            }</text>;
                        Func<dynamic, IHtmlContent> cell3 = @<text>@if (t.BookingCode is not null)
                            {
                                <span class="fx-code">@t.BookingCode</span>@if (t.SettlementId is int settlementId) { <div><a asp-controller="Settlements" asp-action="Details" asp-route-id="@settlementId">@L["Xem kỳ đối soát"]</a></div> }
                                <div class="small text-muted">@L[t.BookingStatus!.Value.DisplayName()] · @L["cần"] <money value="@(t.BookingAmountDue ?? 0)" /></div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }</text>;
                        Func<dynamic, IHtmlContent> cell4 = @<text><status-badge value="@t.MatchStatus" />
                            @if (t.ProcessedBy is not null)
                            {
                                <div class="small text-muted text-nowrap">@t.ProcessedBy · @(t.ProcessedAt is { } at ? VietnamTime.ToLocal(at).ToString("dd/MM") : "")</div>
                            }
                            @if (t.RefundBankRef is not null)
                            {
                                <div class="small text-muted">@L["Mã hoàn"]: @t.RefundBankRef</div>
                            }</text>;
                        Func<dynamic, IHtmlContent> cell5 = @<text>@if (open)
                            {
                                <a class="btn btn-sm btn-brand text-nowrap" asp-action="Process" asp-route-id="@t.Id">@L["Xử lý"]</a>
                            }</text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!), cell3(null!), cell4(null!), cell5(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Giao dịch ngân hàng", new TableColumn[] { new("Thời gian",NoWrap:true), new("Số tiền", Numeric: true), new("Nội dung chuyển khoản"), new("Đơn"), new("Trạng thái"), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
