@* Thanh tab chung của khu Kế toán, kèm số việc đang chờ (AccountingController.LoadCountsAsync) *@
@{
    var counts = ViewData["Counts"] as AccountingCounts;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var tabs = new (string Controller, string Label, string Icon, int? Count)[]
    {
        ("Dashboard", L["Tổng quan"], "bi-speedometer2", null),
        ("Receipts", L["Bill chờ duyệt"], "bi-receipt", counts?.PendingReceipts),
        ("Transactions", L["Giao dịch cần xử lý"], "bi-bank", counts?.OpenTransactions),
        ("Refunds", L["Chờ hoàn tiền"], "bi-arrow-counterclockwise", counts?.PendingRefunds),
    };
}
<nav class="accounting-tabs mb-4" aria-label="@L["Kế toán"]">
    @foreach (var tab in tabs)
    {
        var active = tab.Controller == controller;
        <a class="accounting-tab @(active ? "active" : "")" asp-area="Accounting" asp-controller="@tab.Controller" asp-action="Index"
           aria-current="@(active ? "page" : null)">
            <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
            @if (tab.Count > 0)
            {
                <span class="accounting-count">@tab.Count</span>
            }
        </a>
    }
</nav>
