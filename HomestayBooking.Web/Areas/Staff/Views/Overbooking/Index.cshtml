@using HomestayBooking.Web.Identity
@model StaffOverbookingModel
@{var b=Model.Booking;ViewData["Title"]=L["Xử lý trùng phòng"];}
<partial name="_PageHead" model='new PageHeadModel("Xử lý trùng phòng","","",b.Code+" · "+b.Homestay.Name,ShowCreate:false)' />
<partial name="_Breadcrumb" model='new BreadcrumbModel(new BreadcrumbItem[] {new(b.Code,Url.Action("Details","Bookings",new {id=b.Id})),new("Trùng phòng")})' />
<partial name="_Alert" model='new AlertModel(L["Thống nhất với khách trước khi chọn phương án. Mọi thao tác được ghi lịch sử."].Value,"warning")' />
<section class="fx-card p-4 mb-4 text-break"><h2 class="h5">@L["Đơn hiện tại"]</h2><date-range from="@b.CheckIn" to="@b.CheckOut" /><p>@b.RoomType.Name · @b.Room.RoomCode</p>
 <partial name="_PriceBreakdown" model='new PriceBreakdownModel(new PriceLine[] {new("Tổng tiền",b.TotalAmount),new("Tiền cọc",b.DepositAmount)})' />
</section>
@if(Model.FreeRooms.Count>0){
 <section class="fx-form-card fx-card p-4 mb-4"><h2 class="h5">@L["Chuyển phòng cùng loại"]</h2>
 <partial name="_PriceBreakdown" model='new PriceBreakdownModel(new PriceLine[] {new("Chênh lệch",0m)})' />
 <form asp-action="Move" asp-route-id="@b.Id" method="post" data-confirm="@L["Chuyển phòng cùng loại? Giá và cọc giữ nguyên."]"><label for="roomId" class="form-label">@L["Phòng trống"]</label><select id="roomId" name="roomId" class="form-select mb-3">@foreach(var r in Model.FreeRooms){<option value="@r">@L["Phòng #{0}",r]</option>}</select><label for="move-note" class="form-label">@L["Ghi chú đã thống nhất với khách"]</label><textarea id="move-note" name="note" class="form-control mb-3" required maxlength="400"></textarea><button type="submit" class="btn btn-brand" data-loading-text="@L["Đang lưu…"]">@L["Chuyển phòng"]</button></form></section>
}
<h2 class="h4">@L["Phương án thay thế"]</h2>
@foreach(var a in Model.Alternatives.Where(a=>a.Offer.RoomTypeId!=b.RoomTypeId)) {<partial name="_OverbookingAlternative" model="new OverbookingAlternativeModel(b.Id,a)" />}
@if(!Model.Alternatives.Any(a=>a.Offer.RoomTypeId!=b.RoomTypeId)){<partial name="_EmptyState" model='new EmptyStateModel("Chưa có phương án thay thế.")' />}
<partial name="_Pager" model="Model.Alternatives" />
@if(User.IsManagement()){
 <section class="fx-form-card fx-card p-4"><h2 class="h5">@L["Hoàn tiền do trùng phòng"]</h2><p>@L["Chỉ dùng khi không tìm được phương án. Khoản hoàn chờ kế toán chuyển trả và khách được cấp voucher xin lỗi."]</p>
 <partial name="_PriceBreakdown" model='new PriceBreakdownModel(new PriceLine[] {new("Tiền hoàn",b.AmountDue)})' />
 <form asp-action="Refund" asp-route-id="@b.Id" method="post" data-confirm="@L["Hủy do trùng phòng, hoàn 100% tiền đã chuyển và cấp voucher xin lỗi?"]" data-confirm-variant="danger"><label for="refund-note" class="form-label">@L["Lý do không có phương án"]</label><textarea id="refund-note" name="note" class="form-control mb-3" required maxlength="400"></textarea><button type="submit" class="btn btn-outline-danger" data-loading-text="@L["Đang lưu…"]">@L["Tạo khoản hoàn tiền"]</button></form></section>
}
