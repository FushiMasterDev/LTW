@model PaginatedList<Booking>
@{ ViewData["Title"] = L["Gửi yêu cầu thay khách"]; }
<partial name="_PageHead" model="@(new PageHeadModel(L["Gửi yêu cầu thay khách"], "bi-arrow-repeat", "tone-sky", L["Tìm đơn theo mã hoặc số điện thoại để đổi/hủy thay khách."], ShowCreate: false))" />
<partial name="_FilterBar" model='new FilterBarModel("staff-booking-filter", new FilterField[] { new("q", "Mã đơn hoặc số điện thoại", ViewData["Query"]?.ToString(), Type: "search") })' />
@{ var rows = new List<TableRow>(); }
@foreach (var b in Model)
{
    Func<dynamic, IHtmlContent> booking = @<text><strong>@b.Code</strong><div class="small text-muted">@b.Homestay.Name · @b.RoomType.Name</div></text>;
    Func<dynamic, IHtmlContent> contact = @<text>@b.ContactName<div class="small text-muted">@b.ContactPhone</div></text>;
    Func<dynamic, IHtmlContent> dates = @<text><date-range from="@b.CheckIn" to="@b.CheckOut" /></text>;
    Func<dynamic, IHtmlContent> action = @<text><a asp-action="Create" asp-route-id="@b.Id" class="btn btn-outline-primary">@L["Đổi / hủy thay khách"]</a></text>;
    rows.Add(new(new IHtmlContent[] { booking(null!), contact(null!), dates(null!), action(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Gửi yêu cầu thay khách", new TableColumn[] { new("Đơn"), new("Khách"), new("Ngày ở"), new("Thao tác") }, rows, Model)' />
