@using HomestayBooking.Web.Services
@model PaginatedList<ChangeRequestHistoryRow>
@{ ViewData["Title"] = L["Duyệt yêu cầu đổi/hủy"]; }
<partial name="_PageHead" model="@(new PageHeadModel(L["Duyệt yêu cầu đổi/hủy"], "bi-calendar-check", "tone-amber", L["Quản lý duyệt nghiệp vụ; khoản nộp thêm do kế toán xác nhận."], ShowCreate: false))" />
@if (Model.Count == 0) { <div class="fx-card p-4"><partial name="_EmptyState" /></div> }
@foreach (var row in Model)
{
    var r = row.Request;
    <section class="fx-card p-4 mb-3" data-approval="@r.Id">
        <h2 class="h6">@r.Booking.Code · @r.Booking.Homestay.Name</h2>
        <p class="small">@L["Người gửi"]: @(r.RequestedByAccount?.Person.FullName ?? r.RequestedByAccount?.UserName ?? "—")</p>
        <partial name="_Timeline" model="@(new TimelineModel(Changes: new List<ChangeRequestHistoryRow> { row }))" />
        @if (row.IsLegacy) { <partial name="_Alert" model='new AlertModel(L["Yêu cầu cũ, cần gửi lại"], "warning", false)' /> }
        else
        {
            <partial name="_PriceBreakdown" model="@(PriceBreakdownModel.From(new BookingChangeQuote(r.NewTotalAmount!.Value, r.ChangeFee!.Value, r.DepositCarriedOver!.Value, 0, r.AdditionalDeposit!.Value, r.RefundAmount, null)))" />
            <form asp-action="Approve" asp-route-id="@r.Id" method="post" class="d-flex flex-column flex-sm-row gap-2 mb-2"><label class="visually-hidden" for="approve-@r.Id">@L["Ghi chú duyệt"]</label><input id="approve-@r.Id" name="Note" class="form-control" required maxlength="500" placeholder="@L["Ghi chú duyệt"]" /><button class="btn btn-brand text-nowrap flex-shrink-0" type="submit" data-loading-text="@L["Đang xử lý..."]">@L["Duyệt"]</button></form>
        }
        <form data-confirm="@L["Bạn có chắc muốn tiếp tục?"]" data-confirm-variant="danger" asp-action="Reject" asp-route-id="@r.Id" method="post" class="d-flex flex-column flex-sm-row gap-2"><label class="visually-hidden" for="reject-@r.Id">@L["Lý do từ chối"]</label><input id="reject-@r.Id" name="Note" class="form-control" required maxlength="500" placeholder="@L["Lý do từ chối"]" /><button class="btn btn-outline-danger text-nowrap flex-shrink-0" type="submit" data-loading-text="@L["Đang xử lý..."]">@L["Từ chối"]</button></form>
    </section>
}
<partial name="_Pager" model="Model" />
