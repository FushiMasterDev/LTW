@model Dictionary<BookingStatus, int>
@{
    ViewData["Title"] = L["Tổng quan nhân viên"];
    var groups = new (string Title, string Hint, string Icon, BookingStatus[] Statuses)[]
    {
        (L["Đang chờ xử lý"], L["Đơn đang giữ phòng, chờ duyệt bill hoặc chờ homestay xác nhận."], "bi-hourglass-split",
            [BookingStatus.AwaitingPayment, BookingStatus.PaymentSubmitted, BookingStatus.Deposited]),
        (L["Sắp đến và đang ở"], L["Đơn đã xác nhận và khách đang lưu trú."], "bi-door-open",
            [BookingStatus.Confirmed, BookingStatus.CheckedIn]),
        (L["Đã kết thúc"], L["Hoàn thành, hết hạn, bị từ chối, đã hủy hoặc khách không đến."], "bi-archive",
            [BookingStatus.Completed, BookingStatus.Expired, BookingStatus.Rejected, BookingStatus.Cancelled, BookingStatus.NoShow]),
    };
    var waitingConfirm = Model.GetValueOrDefault(BookingStatus.Deposited);
}
<partial name="_PageHead" model='new PageHeadModel("Tổng quan nhân viên", "", "", L["Hệ thống đang có {0} homestay hoạt động.", (object)ViewBag.ActiveHomestayCount], ShowCreate: false)' />

<div class="row g-3 mb-4">
    @foreach (var g in groups)
    {
        <div class="col-md-4"><partial name="_StatCard" model="@(new StatCardModel(g.Title, g.Statuses.Sum(s => Model.GetValueOrDefault(s)).ToString(), g.Icon, Hint: g.Hint))" /></div>
    }
</div>
<partial name="_TaskList" model='new TaskListModel("Việc cần xử lý", new TaskListItem[] {
    new("Đơn chờ xác nhận", L["{0} đơn đã nhận cọc đang chờ homestay xác nhận.", waitingConfirm], Value: waitingConfirm),
    new("Gửi yêu cầu thay khách", L["Tìm đơn theo mã hoặc số điện thoại để đổi/hủy thay khách."], Url.Action("Index", "ChangeRequests")) })' />
<h2 class="fx-section-title mt-4">@L["Đơn đặt phòng theo trạng thái"]</h2>
@{ var rows = new List<TableRow>(); }
@foreach (var status in groups.SelectMany(g => g.Statuses))
{
    Func<dynamic, IHtmlContent> badge = @<text><status-badge value="@status" /></text>;
    rows.Add(new(new IHtmlContent[] { badge(null!), new HtmlContentBuilder().Append(Model.GetValueOrDefault(status).ToString()) }));
}
<partial name="_DataTable" model='new DataTableModel("Đơn đặt phòng theo trạng thái", new TableColumn[] { new("Trạng thái"), new("Đơn", Numeric: true) }, rows)' />
