@using HomestayBooking.Web.Identity
@using HomestayBooking.Web.Areas.Owner.Controllers
@model OwnerDashboardViewModel
@{
    ViewData["Title"] = L["Tổng quan chủ homestay"];
    var homestays = Model.Homestays;
    var activeCount = homestays.Count(h => h.Status == HomestayStatus.Active);
    var roomCount = homestays.Sum(h => h.RoomCount);
}
<partial name="_PageHead" model='new PageHeadModel("Tổng quan chủ homestay", "", "", L["Bạn đang quản lý {0} homestay.", homestays.Count], ShowCreate: false)' />

@if (Model.RegistrationStatus is { } status && status != OwnerRegistrationStatus.Approved)
{
    @* Owner chưa được duyệt chỉ xem được trạng thái hồ sơ (v5 mục 6.1) *@
    <div class="alert @status.ToneClass() d-flex gap-2" role="status">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <div>
            <strong>@L["Trạng thái hồ sơ đăng ký"]: @L[status.DisplayName()]</strong>
            <div>@L["Các chức năng quản lý homestay sẽ mở sau khi Fuji duyệt hồ sơ."]</div>
            @if (!string.IsNullOrWhiteSpace(Model.ReviewNote))
            {
                <div class="mt-1"><em>@L["Ghi chú của Fuji"]:</em> @Model.ReviewNote</div>
            }
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <partial name="_StatCard" model='new StatCardModel("Homestay", homestays.Count.ToString(), "houses")' />
    </div>
    <div class="col-sm-4">
        <partial name="_StatCard" model='new StatCardModel("Đang hoạt động", activeCount.ToString(), "toggle-on")' />
    </div>
    <div class="col-sm-4">
        <partial name="_StatCard" model='new StatCardModel("Phòng", roomCount.ToString(), "door-closed")' />
    </div>
</div>

@if (User.IsApprovedOwner())
{
<partial name="_TaskList" model='new TaskListModel("Việc cần xử lý", new TaskListItem[] { new("Đơn đặt phòng", L["Đơn đã đặt cọc của homestay bạn. Xác nhận trong 30 phút sau khi khách đặt cọc."], Url.Action("Index", "Bookings")) })' />
}

<h2 class="fx-section-title"><i class="bi bi-house-gear" aria-hidden="true"></i> @L["Homestay của tôi"]</h2>
@{ var rows = new List<TableRow>(); }
@foreach (var h in homestays)
                {
                    Func<dynamic, IHtmlContent> cell0 = @<text>@h.Name</text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text><i class="bi bi-geo-alt text-muted me-1" aria-hidden="true"></i>@h.AreaName</text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text><span class="fx-count">@h.RoomCount</span></text>;
                        Func<dynamic, IHtmlContent> cell3 = @<text><status-badge value="@h.Status" /></text>;
                        Func<dynamic, IHtmlContent> cell4 = @<text>@if (h.Status == HomestayStatus.Active)
                            {
                                <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-area="" asp-controller="Homestays" asp-action="Details" asp-route-id="@h.Id"
                                   aria-label="@L["Xem trang khách của {0}", h.Name]">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> @L["Xem trang khách"]
                                </a>
                            }</text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!), cell3(null!), cell4(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Tổng quan chủ homestay", new TableColumn[] { new("Homestay"), new("Khu vực"), new("Số phòng", Numeric: true), new("Trạng thái", Numeric: true), new("Thao tác") }, rows)' />
