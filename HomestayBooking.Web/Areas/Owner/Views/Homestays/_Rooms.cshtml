@model OwnerEditorModel
<p class="text-muted">@L["Giá mới áp dụng từ ngày hiệu lực. Giá đã có hiệu lực được giữ nguyên; đơn cũ giữ giá đã chốt."]</p>
@foreach (var t in Model.Home.RoomTypes) {
<section class="mb-4 pb-4 border-bottom">
    <h2 class="h5">@t.Name</h2><p class="text-muted">@t.CategoryName · @L[t.IsActive ? "Đang bán" : "Ngừng bán"]</p>
    <form asp-action="RoomType" asp-route-id="@Model.Home.Id" method="post" data-owner-form>
        <input type="hidden" name="typeId" value="@t.Id" />
        <label class="form-label" for="type-name-@t.Id">@L["Tên loại phòng"]</label><input class="form-control mb-3" id="type-name-@t.Id" name="name" value="@t.Name" maxlength="100" required autocomplete="off" />
        <label class="form-label" for="guests-@t.Id">@L["Số khách tối đa"]</label><input class="form-control mb-3" id="guests-@t.Id" name="maxGuests" type="number" min="1" value="@t.MaxGuests" required inputmode="numeric" />
        <label class="form-label" for="area-@t.Id">@L["Diện tích (m²)"]</label><input class="form-control mb-3" id="area-@t.Id" name="areaM2" type="number" min="1" value="@t.AreaM2" inputmode="numeric" />
        <label class="form-label" for="description-@t.Id">@L["Mô tả"]</label><textarea class="form-control mb-3" id="description-@t.Id" name="description" maxlength="1000">@t.Description</textarea>
        <button class="btn btn-brand" type="submit" data-loading-text="@L["Đang lưu…"]">@L["Lưu loại phòng"]</button>
    </form>
    <form asp-action="Active" asp-route-id="@Model.Home.Id" method="post" class="my-3" data-confirm="@L["Thay đổi trạng thái bán? Hãy kiểm tra các đơn sắp tới."]">
        <input type="hidden" name="typeId" value="@t.Id" /><input type="hidden" name="active" value="@((!t.IsActive).ToString().ToLowerInvariant())" />
        <button type="submit" class="btn btn-outline-secondary">@L[t.IsActive ? "Ngừng bán loại phòng" : "Mở bán loại phòng"]</button>
    </form>
    <h3 class="h6 mt-4">@L["Giá hiện hành"]</h3>
    @foreach (var p in t.CurrentPrices) { <p>@L[p.DayType.DisplayName()]: <money value="@p.Price" /> · @p.EffectiveFrom.ToString("dd/MM/yyyy")</p> }
    @if (t.UpcomingPrices.Count > 0) { <h3 class="h6">@L["Giá sắp áp dụng"]</h3> }
    @foreach (var p in t.UpcomingPrices) { <p>@L[p.DayType.DisplayName()]: <money value="@p.Price" /> · @p.EffectiveFrom.ToString("dd/MM/yyyy")</p> }
    <form asp-action="Price" asp-route-id="@Model.Home.Id" method="post" class="my-3" data-owner-form>
        <input type="hidden" name="typeId" value="@t.Id" />
        <label class="form-label" for="day-@t.Id">@L["Mức giá"]</label><select class="form-select mb-3" name="dayType" id="day-@t.Id">@foreach (var day in Enum.GetValues<DayType>()) { <option value="@day">@L[day.DisplayName()]</option> }</select>
        <label class="form-label" for="effective-@t.Id">@L["Ngày hiệu lực"]</label><input class="form-control mb-3" id="effective-@t.Id" name="effectiveFrom" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Today.ToString("yyyy-MM-dd")" required />
        <label class="form-label" for="price-@t.Id">@L["Giá mỗi đêm (đ)"]</label><input class="form-control mb-3" id="price-@t.Id" name="price" type="number" min="1" step="1" required inputmode="numeric" />
        <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang lưu…"]">@L["Lưu giá"]</button>
    </form>
    <h3 class="h6 mt-4">@L["Phòng"]</h3>
    @foreach (var room in t.Rooms) {
        <form asp-action="Room" asp-route-id="@Model.Home.Id" method="post" class="my-3" data-owner-form>
            <input type="hidden" name="roomId" value="@room.Id" />
            <label class="form-label" for="code-@room.Id">@L["Mã phòng"] · @L[room.IsActive ? "Đang bán" : "Ngừng bán"]</label>
            <input class="form-control mb-2" id="code-@room.Id" name="code" value="@room.RoomCode" maxlength="20" required autocomplete="off" spellcheck="false" />
            <button type="submit" class="btn btn-outline-secondary" data-loading-text="@L["Đang lưu…"]">@L["Lưu mã phòng"]</button>
        </form>
        <form asp-action="Active" asp-route-id="@Model.Home.Id" method="post" data-confirm="@L["Thay đổi trạng thái bán? Hãy kiểm tra các đơn sắp tới."]">
            <input type="hidden" name="typeId" value="@t.Id" /><input type="hidden" name="roomId" value="@room.Id" /><input type="hidden" name="active" value="@((!room.IsActive).ToString().ToLowerInvariant())" />
            <button type="submit" class="btn btn-outline-secondary">@L[room.IsActive ? "Ngừng bán phòng" : "Mở bán phòng"]</button>
        </form>
    }
    <form asp-action="AddRoom" asp-route-id="@Model.Home.Id" method="post" class="mt-3" data-owner-form>
        <input type="hidden" name="typeId" value="@t.Id" /><label class="form-label" for="new-room-@t.Id">@L["Mã phòng mới"]</label>
        <input class="form-control mb-2" name="code" id="new-room-@t.Id" maxlength="20" required autocomplete="off" spellcheck="false" />
        <button class="btn btn-brand" type="submit" data-loading-text="@L["Đang lưu…"]">@L["Thêm phòng"]</button>
    </form>
</section>
}
@if (Model.Home.RoomTypes.Count == 0) { <partial name="_EmptyState" /> }
<p class="small text-muted">@L["Tạo loại phòng và đổi danh mục cần danh mục quản lý đầy đủ. Vui lòng liên hệ Fuji."]</p>
