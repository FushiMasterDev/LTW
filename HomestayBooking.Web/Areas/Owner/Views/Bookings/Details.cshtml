@using HomestayBooking.Web.Areas.Owner.Controllers
@using HomestayBooking.Web.Identity
@using HomestayBooking.Web.Services
@model OwnerBookingDetailsViewModel
@{
    var b = Model.Booking;
    ViewData["Title"] = L["Đơn {0}", b.Code];
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Đơn {0}", b.Code], b.Status.Icon(), b.Status.ToneClass(), b.Homestay.Name, ShowCreate: false))" />

<partial name="_Breadcrumb" model='new BreadcrumbModel(new BreadcrumbItem[] { new("Đơn đặt phòng", Url.Action("Index")), new(b.Code) })' />
<p><a asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> @L["Về danh sách đơn"]</a></p>

<div class="fx-booking-detail">
    <section class="fx-booking-detail__facts">
        <div class="fx-card p-3 mb-3">
            @{
    var facts = new List<DescriptionItem>();

                Func<dynamic, IHtmlContent> fact0 = @<text><status-badge value="@b.Status" /></text>;
    facts.Add(new("Trạng thái", fact0(null!)));
                Func<dynamic, IHtmlContent> fact1 = @<text>@b.ContactName · @PhoneNumberNormalizer.ToNational(b.ContactPhone) · @L["{0} khách", b.Guests]</text>;
    facts.Add(new("Khách", fact1(null!)));
                Func<dynamic, IHtmlContent> fact2 = @<text>@b.RoomType.Name · @b.Room.RoomCode</text>;
    facts.Add(new("Phòng", fact2(null!)));
                Func<dynamic, IHtmlContent> fact3 = @<text>@b.CheckIn.ToString("dd/MM/yyyy") – @b.CheckOut.ToString("dd/MM/yyyy")</text>;
    facts.Add(new("Ngày ở", fact3(null!)));
                Func<dynamic, IHtmlContent> fact4 = @<text><money value="@b.TotalAmount" /></text>;
    facts.Add(new("Tổng tiền", fact4(null!)));
                Func<dynamic, IHtmlContent> fact5 = @<text><money value="@b.DepositAmount" /></text>;
    facts.Add(new("Tiền cọc", fact5(null!)));
                if (b.Status == BookingStatus.Deposited && b.ConfirmDeadlineAt is { } deadline)
                {
                    Func<dynamic, IHtmlContent> fact6 = @<text>@VietnamTime.ToLocal(deadline).ToString("HH:mm dd/MM/yyyy")</text>;
    facts.Add(new("Hạn xác nhận", fact6(null!)));
                }
                if (!string.IsNullOrWhiteSpace(b.SpecialRequests))
                {
                    Func<dynamic, IHtmlContent> fact7 = @<text>@b.SpecialRequests</text>;
    facts.Add(new("Yêu cầu đặc biệt", fact7(null!)));
                }
                if (b.CancelReason is not null)
                {
                    Func<dynamic, IHtmlContent> fact8 = @<text>@b.CancelReason</text>;
    facts.Add(new("Lý do", fact8(null!)));
                }

}
<partial name="_DescriptionList" model="facts" />
        </div>

    </section>
    <section class="fx-booking-detail__history">
        <h2 class="fx-section-title h5">@L["Yêu cầu đổi"]</h2>
        <partial name="_Timeline" model="@(new TimelineModel(Changes: Model.ChangeHistory))" />
        <h2 class="fx-section-title h5">@L["Lịch sử"]</h2>
        <partial name="_Timeline" model='new TimelineModel(Events: b.Histories.OrderBy(h => h.ChangedAt).Select(h => new TimelineItem(h.ChangedAt, h.ToStatus.DisplayName(), h.Note)).ToArray())' />
    </section>

    <aside class="fx-booking-detail__actions">
        <div class="fx-card p-3">
            <h2 class="h5">@L["Thao tác"]</h2>
            @switch (b.Status)
            {
                case BookingStatus.Deposited:
                    <form asp-action="Confirm" asp-route-id="@b.Id" method="post" class="mb-3">
                        @if (Model.FreeRooms.Count > 0)
                        {
                            <label for="roomId" class="form-label">@L["Phòng"]</label>
                            <select id="roomId" name="roomId" class="form-select mb-2">
                                <option value="">@L["Giữ phòng {0}", b.Room.RoomCode]</option>
                                @foreach (var r in Model.FreeRooms)
                                {
                                    <option value="@r.Id">@L["Đổi sang phòng {0}", r.RoomCode]</option>
                                }
                            </select>
                        }
                        <button type="submit" data-loading-text="@L["Đang xử lý..."]" class="btn btn-brand w-100"><i class="bi bi-check2-circle" aria-hidden="true"></i> @L["Xác nhận đơn"]</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@b.Id" method="post"
                          data-confirm-variant="danger" data-confirm="@L["Từ chối đơn {0}? Fuji sẽ hoàn 100% tiền cọc cho khách.", b.Code]">
                        <label for="reason" class="form-label">@L["Lý do từ chối"]</label>
                        <textarea id="reason" name="reason" class="form-control mb-2" rows="2" required maxlength="500"></textarea>
                        <button type="submit" data-loading-text="@L["Đang xử lý..."]" class="btn btn-outline-danger w-100"><i class="bi bi-x-circle" aria-hidden="true"></i> @L["Từ chối đơn"]</button>
                    </form>
                    break;
                case BookingStatus.Confirmed:
                    @* Cùng điều kiện ngày với BookingService: nhận phòng từ ngày CheckIn, không đến từ ngày hôm sau *@
                    @if (Model.Today >= b.CheckIn)
                    {
                        <form asp-action="CheckIn" asp-route-id="@b.Id" method="post" class="mb-2">
                            <button type="submit" data-loading-text="@L["Đang xử lý..."]" class="btn btn-brand w-100"><i class="bi bi-door-open" aria-hidden="true"></i> @L["Khách đã nhận phòng"]</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-2">@L["Nhận phòng mở từ ngày {0}.", b.CheckIn.ToString("dd/MM/yyyy")]</p>
                    }
                    @if (Model.Today > b.CheckIn)
                    {
                        <form asp-action="NoShow" asp-route-id="@b.Id" method="post"
                              data-confirm-variant="danger" data-confirm="@L["Đánh dấu khách không đến đơn {0}? Khách sẽ không được hoàn cọc.", b.Code]">
                            <button type="submit" data-loading-text="@L["Đang xử lý..."]" class="btn btn-outline-danger w-100"><i class="bi bi-person-x" aria-hidden="true"></i> @L["Khách không đến"]</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">@L["Đánh dấu khách không đến mở từ ngày {0}.", b.CheckIn.AddDays(1).ToString("dd/MM/yyyy")]</p>
                    }
                    break;
                case BookingStatus.CheckedIn:
                    <form asp-action="Complete" asp-route-id="@b.Id" method="post"
                          data-confirm="@L["Hoàn thành đơn {0}?", b.Code]">
                        <button type="submit" data-loading-text="@L["Đang xử lý..."]" class="btn btn-brand w-100"><i class="bi bi-trophy" aria-hidden="true"></i> @L["Khách đã trả phòng"]</button>
                    </form>
                    break;
                default:
                    <p class="text-muted mb-0">@L["Đơn này không còn thao tác nào."]</p>
                    break;
            }
        </div>
    </aside>
</div>

<a class="btn btn-outline-secondary mt-3" asp-controller="Reviews" asp-action="Index" asp-route-homestayId="@Model.Booking.HomestayId">@L["Xem và trả lời đánh giá"]</a>
