@using HomestayBooking.Web.Areas.Owner.Controllers
@using HomestayBooking.Web.Identity
@using HomestayBooking.Web.Services
@model PaginatedList<OwnerBookingRow>
@{
    ViewData["Title"] = L["Đơn đặt phòng"];
    var status = ViewData["Status"] as BookingStatus?;
    // Owner chỉ thấy đơn từ khi đã cọc (database v1 mục 9)
    BookingStatus[] statuses = [BookingStatus.Deposited, BookingStatus.Confirmed, BookingStatus.CheckedIn, BookingStatus.Completed,
        BookingStatus.Rejected, BookingStatus.Cancelled, BookingStatus.NoShow];
}
<partial name="_PageHead" model="@(new PageHeadModel(L["Đơn đặt phòng"], "bi-journal-check", "tone-violet", L["Đơn đã đặt cọc của homestay bạn. Xác nhận trong 30 phút sau khi khách đặt cọc."], ShowCreate: false))" />

<partial name="_FilterBar" model='new FilterBarModel("owner-booking-filter", new FilterField[] {
    new("status", "Trạng thái", Options: new[] { new SelectListItem(L["Tất cả trạng thái"], "") }.Concat(statuses.Select(v => new SelectListItem(L[v.DisplayName()], v.ToString(), v == status))).ToArray()),
    new("q", "Tìm theo mã đơn, tên hoặc SĐT khách", ViewData["Query"]?.ToString(), Type: "search") })' />

@{ var rows = new List<TableRow>(); }
@foreach (var r in Model)
                {
                    Func<dynamic, IHtmlContent> cell0 = @<text><span class="fx-code fw-semibold">@r.Code</span>
                            <div><status-badge value="@r.Status" /></div>
                            @if (r.Status == BookingStatus.Deposited && r.ConfirmDeadlineAt is { } deadline)
                            {
                                <div class="small text-muted">@L["Hạn xác nhận {0}", VietnamTime.ToLocal(deadline).ToString("HH:mm dd/MM")]</div>
                            }</text>;
                        Func<dynamic, IHtmlContent> cell1 = @<text>@r.ContactName<div class="small text-muted">@PhoneNumberNormalizer.ToNational(r.ContactPhone) · @L["{0} khách", r.Guests]</div></text>;
                        Func<dynamic, IHtmlContent> cell2 = @<text>@r.RoomTypeName<div class="small text-muted">@r.HomestayName · @r.RoomCode</div></text>;
                        Func<dynamic, IHtmlContent> cell3 = @<text>@r.CheckIn.ToString("dd/MM") – @r.CheckOut.ToString("dd/MM/yyyy")</text>;
                        Func<dynamic, IHtmlContent> cell4 = @<text><money value="@r.TotalAmount" /></text>;
                        Func<dynamic, IHtmlContent> cell5 = @<text><a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@r.Id"
                               aria-label="@L["Xem đơn {0}", r.Code]">@L["Xem"]</a></text>;
                    rows.Add(new TableRow(new IHtmlContent[] { cell0(null!), cell1(null!), cell2(null!), cell3(null!), cell4(null!), cell5(null!) }));
}
<partial name="_DataTable" model='new DataTableModel("Đơn đặt phòng", new TableColumn[] { new("Đơn"), new("Khách"), new("Phòng"), new("Ngày ở"), new("Tổng tiền", Numeric: true), new("Thao tác") }, rows)' />
<partial name="_Pager" model="Model" />
