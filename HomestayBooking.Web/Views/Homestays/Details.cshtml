@using HomestayBooking.Web.TagHelpers
@using HomestayBooking.Web.Services
@inject TimeProvider Clock
@model HomestayDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var q = Model.Query;
    var today = VietnamTime.Today(Clock);
    var nights = q.HasDates ? q.CheckOut!.Value.DayNumber - q.CheckIn!.Value.DayNumber : 0;
    var reviews = Model.Reviews;
    // Bộ chọn ngày ở cấp homestay chỉ khóa đêm hết phòng khi homestay bán đúng một loại phòng (endpoint tính theo loại phòng).
    var blockedUrl = Model.RoomTypes.Count == 1
        ? Url.Action("BlockedDates", new { roomTypeId = Model.RoomTypes[0].Id, from = today.ToString("yyyy-MM-dd"), to = today.AddDays(92).ToString("yyyy-MM-dd") })
        : null;
    var cheapest = Model.RoomTypes.Where(t => t.Quote is not null && t.FreeRooms > 0 && t.MaxGuests >= q.Guests).MinBy(t => t.Quote!.Total);
    var price = new PriceBreakdownModel(cheapest?.Quote is { } quote
        ? [new PriceLine("Tổng tiền thấp nhất", quote.Total), new PriceLine("Tiền cọc", quote.Deposit), new PriceLine("Thanh toán tại homestay", quote.Total - quote.Deposit)]
        : null);
    var panelEmpty = !q.HasDates ? "Chọn ngày nhận và trả phòng để xem phòng trống và tổng tiền."
        : cheapest is null ? "Không còn loại phòng phù hợp trong những ngày này." : null;
    var panel = new BookingPanelModel("stay-panel", new DateRangePickerModel("stay-dates", q.CheckIn, q.CheckOut, BlockedUrl: blockedUrl),
        new GuestPickerModel("stay-guests", Value: q.Guests), price, Url.Action("Details", new { id = Model.Id })!,
        Title: "Chọn ngày", SubmitLabel: "Xem phòng trống", Empty: panelEmpty,
        Note: "Địa chỉ chính xác và số điện thoại homestay được gửi sau khi đơn được xác nhận.");
}

@section Head {
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
}

<partial name="_Breadcrumb" model="@(new BreadcrumbModel([new BreadcrumbItem("Tìm homestay", Url.Action("Index")), new BreadcrumbItem(Model.Name)]))" />

<header class="stay-head">
    <h1>@Model.Name</h1>
    <ul class="stay-head__facts">
        <li><icon name="geo-alt" />@Model.AreaName, @L["Hà Nội"]</li>
        @if (reviews?.Average is not null)
        {
            <li><a href="#reviews"><rating value="reviews.Average" count="reviews.Count" /></a></li>
        }
        <li><icon name="clock" />@L["Nhận phòng từ {0}, trả phòng trước {1}", Model.CheckinTime.ToString("HH:mm"), Model.CheckoutTime.ToString("HH:mm")]</li>
    </ul>
</header>

<partial name="_Gallery" model="@(new GalleryModel(Model.Name, Model.Images))" />

<div class="stay-layout">
    <div class="stay-layout__panel">
        <partial name="_BookingPanel" model="panel" />
    </div>

    <div class="stay-layout__main">
        <section class="stay-section" id="rooms" aria-labelledby="roomsTitle">
            <h2 id="roomsTitle">@L["Loại phòng"]</h2>
            @if (q.HasDates)
            {
                <p class="stay-section__lead">@L["{0} đêm, từ {1} đến {2}, cho {3} khách.", nights, q.CheckIn!.Value.ToString("dd/MM"), q.CheckOut!.Value.ToString("dd/MM/yyyy"), q.Guests]</p>
            }
            else
            {
                <p class="stay-section__lead">@L["Chọn ngày nhận và trả phòng để xem phòng trống và tổng tiền."]</p>
            }
            @if (Model.RoomTypes.Count == 0)
            {
                <partial name="_EmptyState" model='new EmptyStateModel("Chưa có loại phòng đang mở bán.", "Vui lòng chọn homestay khác hoặc gọi 1900 0000 để được tư vấn.", "door-closed")' />
            }
            <ul class="stay-rooms">
                @foreach (var t in Model.RoomTypes)
                {
                    <partial name="_RoomOption" model="@(new RoomOptionModel(t, q))" />
                }
            </ul>
        </section>

        @if (!string.IsNullOrEmpty(Model.DescriptionHtml))
        {
            <section class="stay-section" aria-labelledby="aboutTitle">
                <h2 id="aboutTitle">@L["Giới thiệu"]</h2>
                <div class="rich-text">@Html.Raw(Model.DescriptionHtml)</div>
            </section>
        }

        @if (Model.Amenities.Count > 0)
        {
            <section class="stay-section" aria-labelledby="amenitiesTitle">
                <h2 id="amenitiesTitle">@L["Tiện nghi"]</h2>
                <ul class="stay-amenities">
                    @foreach (var (name, icon) in Model.Amenities)
                    {
                        <li class="fx-chip"><icon name="check2" />@name</li>
                    }
                </ul>
            </section>
        }

        @if (reviews is not null)
        {
            <section class="stay-section" id="reviews" aria-labelledby="reviewsTitle">
                <h2 id="reviewsTitle">@L["Đánh giá của khách"]</h2>
                @if (reviews.Count == 0)
                {
                    <p class="stay-section__lead">@L["Chưa có đánh giá. Khách đã ở có thể đánh giá sau khi trả phòng."]</p>
                }
                else
                {
                    <div class="stay-score">
                        <p class="stay-score__value">@reviews.Average!.Value.ToString("0.0")</p>
                        <p class="stay-score__label">@L["trên 5, từ {0} đánh giá", reviews.Count]</p>
                    </div>
                    <ul class="stay-reviews">
                        @foreach (var r in reviews.Reviews)
                        {
                            <partial name="_ReviewCard" model="@(new ReviewCardModel(r.Rating, r.CreatedAt, r.Comment, r.OwnerReply, r.Booking?.ContactName))" />
                        }
                    </ul>
                    @if (reviews.Reviews.TotalPages > 1) { <partial name="_Pager" model="reviews.Reviews" /> }
                }
            </section>
        }

        <section class="stay-section" aria-labelledby="policyTitle">
            <h2 id="policyTitle">@L["Chính sách hủy"]</h2>
            <p class="stay-section__lead">@L["Tiền cọc {0:P0} tổng tiền phòng. Số tiền hoàn tính theo số ngày còn lại trước ngày nhận phòng.", Model.DepositRate]</p>
            <partial name="_PriceBreakdown" model="@(new PriceBreakdownModel(Rules: Model.GeneralPolicy))" />
            @if (Model.HolidayPolicy is not null)
            {
                <h3 class="stay-section__sub">@L["Đơn có đêm ngày lễ"]</h3>
                <partial name="_PriceBreakdown" model="@(new PriceBreakdownModel(Rules: Model.HolidayPolicy))" />
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/vn.min.js"></script>
    <script src="~/js/components/date-range-picker.js" asp-append-version="true"></script>
    <script src="~/js/components/guest-picker.js" asp-append-version="true"></script>
}
