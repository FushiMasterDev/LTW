@model HomestaySearchViewModel
@{
    ViewData["Title"] = L["Tìm homestay"];
    var q = Model.Query;
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var hasFilter = q.AreaId is not null || q.HasDates || q.MaxPrice is not null || !string.IsNullOrWhiteSpace(q.Q) || q.Guests != 2;
}

<div class="page-head">
    <div>
        <h1>@L["Tìm homestay"]</h1>
        <p class="text-muted mb-0">@L["Chọn ngày để chỉ xem homestay còn phòng trống."]</p>
    </div>
</div>

<form method="get" class="card-soft filter-bar" role="search" aria-label="@L["Bộ lọc tìm kiếm"]" data-date-range>
    <div class="row g-3 align-items-end">
        <div class="col-md-6 col-lg-3">
            <label class="form-label" for="Q">@L["Tên homestay"]</label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
                <input class="form-control" id="Q" name="Q" value="@q.Q" placeholder="@L["Ví dụ: Tây Hồ"]" />
            </div>
        </div>
        <div class="col-md-6 col-lg-2">
            <label class="form-label" for="AreaId">@L["Khu vực"]</label>
            <select class="form-select" id="AreaId" name="AreaId">
                <option value="">@L["Tất cả"]</option>
                @foreach (var group in Model.Areas.GroupBy(a => a.Group))
                {
                    <optgroup label="@L[group.Key.DisplayName()]">
                        @foreach (var a in group)
                        {
                            <option value="@a.Id" selected="@(q.AreaId == a.Id)">@a.Name</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="CheckIn">@L["Nhận phòng"]</label>
            <input class="form-control" type="date" id="CheckIn" name="CheckIn" min="@today" value="@q.CheckIn?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="CheckOut">@L["Trả phòng"]</label>
            <input class="form-control" type="date" id="CheckOut" name="CheckOut" min="@today" value="@q.CheckOut?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-1">
            <label class="form-label" for="Guests">@L["Số khách"]</label>
            <input class="form-control" type="number" id="Guests" name="Guests" min="1" max="20" value="@q.Guests" inputmode="numeric" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="MaxPrice">@L["Giá tối đa / đêm"]</label>
            <select class="form-select" id="MaxPrice" name="MaxPrice">
                <option value="">@L["Không giới hạn"]</option>
                @foreach (var price in new[] { 400_000m, 600_000m, 800_000m, 1_200_000m })
                {
                    <option value="@price" selected="@(q.MaxPrice == price)">@price.ToString("N0")đ</option>
                }
            </select>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-brand"><i class="bi bi-search" aria-hidden="true"></i> @L["Tìm"]</button>
        @if (hasFilter)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Xóa bộ lọc"]</a>
        }
    </div>
</form>

@if (Model.Results.TotalCount == 0)
{
    <div class="card-soft"><partial name="_EmptyState" model='new EmptyStateModel("Không có homestay phù hợp.", "Hãy thử đổi ngày, bớt số khách hoặc chọn khu vực khác.", "house-x", "Xóa bộ lọc", Url.Action("Index"))' /></div>
}
else
{
    <div class="search-summary" role="status">
        <span>
            @if (q.HasDates)
            {
                @L["{0} homestay còn phòng từ {1} đến {2}", Model.Results.TotalCount, q.CheckIn!.Value.ToString("dd/MM"), q.CheckOut!.Value.ToString("dd/MM/yyyy")]
            }
            else
            {
                @L["{0} homestay phù hợp. Chọn ngày để xem phòng trống.", Model.Results.TotalCount]
            }
        </span>
    </div>

    <div class="stay-grid">
        @foreach (var h in Model.Results)
        {
            <a class="stay-card" asp-action="Details" asp-route-id="@h.Id"
               asp-route-checkIn="@q.CheckIn?.ToString("yyyy-MM-dd")" asp-route-checkOut="@q.CheckOut?.ToString("yyyy-MM-dd")" asp-route-guests="@q.Guests">
                <div class="stay-media">
                    <span class="stay-fallback" aria-hidden="true">
                        <i class="bi bi-house-heart"></i>
                        <small>@L["Chưa có ảnh"]</small>
                    </span>
                    @if (h.CoverUrl is not null)
                    {
                        <img src="@h.CoverUrl.Thumbnail()" alt="" loading="lazy" width="640" height="427" />
                    }
                </div>
                <div class="stay-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h2 class="stay-title">@h.Name</h2>
                        <span class="badge-tone tone-slate flex-shrink-0">@L["≤ {0} khách", h.MaxGuests]</span>
                    </div>
                    <p class="stay-meta"><i class="bi bi-geo-alt" aria-hidden="true"></i> @h.AreaName</p>
                    @if (h.Amenities.Count > 0)
                    {
                        <p class="stay-meta small">@string.Join(", ", h.Amenities)</p>
                    }
                    @if (h.FromPrice is decimal price)
                    {
                        <p class="stay-price"><span class="text-muted small">@L["Từ"]</span> <span class="price">@price.ToString("N0")đ</span><span class="text-muted small"> / @L["đêm"]</span></p>
                    }
                </div>
            </a>
        }
    </div>
    <partial name="_Pager" model="Model.Results" />
}
