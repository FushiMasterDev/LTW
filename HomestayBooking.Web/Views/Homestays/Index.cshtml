@using System.Globalization
@model HomestaySearchViewModel
@{
    ViewData["Title"] = L["Tìm homestay"];
    var q = Model.Query;
    string Invariant(decimal value) => value.ToString(CultureInfo.InvariantCulture);
    var areas = Model.Areas.Select(a => new SelectListItem(a.Name, a.Id.ToString())).ToList();
    var minPrices = new[] { 300_000m, 500_000m, 800_000m };
    var maxPrices = new[] { 400_000m, 600_000m, 800_000m, 1_200_000m };
    var sorts = new (HomestaySort Value, string Label)[]
    {
        (HomestaySort.Default, "Phù hợp nhất"), (HomestaySort.PriceAscending, "Giá thấp đến cao"),
        (HomestaySort.PriceDescending, "Giá cao đến thấp"), (HomestaySort.Rating, "Điểm đánh giá cao"),
    };
    var fields = new List<FilterField>
    {
        new("Q", "Tên homestay", q.Q),
        new("MinPrice", "Giá từ / đêm", Options: minPrices.Select(p => new SelectListItem(p.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ", Invariant(p), q.MinPrice == p))
            .Prepend(new SelectListItem("Bất kỳ", "", q.MinPrice is null)).ToList()),
        new("MaxPrice", "Giá đến / đêm", Options: maxPrices.Select(p => new SelectListItem(p.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ", Invariant(p), q.MaxPrice == p))
            .Prepend(new SelectListItem("Bất kỳ", "", q.MaxPrice is null)).ToList()),
        new("CategoryId", "Loại phòng", Options: Model.Categories.Select(c => new SelectListItem(c.Name, c.Id.ToString(), q.CategoryId == c.Id))
            .Prepend(new SelectListItem("Tất cả", "", q.CategoryId is null)).ToList()),
        new("Sort", "Sắp xếp", Options: sorts.Select(s => new SelectListItem(s.Label, s.Value.ToString(), q.Sort == s.Value)).ToList()),
    };
    if (Model.Amenities.Count > 0)
    {
        fields.Add(new("AmenityIds", "Tiện nghi", Type: "checkbox",
            Options: Model.Amenities.Select(a => new SelectListItem(a.Name, a.Id.ToString(), q.AmenityIds.Contains(a.Id))).ToList()));
    }
}

@section Head {
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
}

<div class="stays-head">
    <h1>@L["Tìm homestay"]</h1>
    <p>@L["Chọn ngày để chỉ xem homestay còn phòng trống."]</p>
</div>

<partial name="_SearchBar" model="@(new SearchBarModel("stays-search", areas, q))" />
<partial name="_FilterBar" model="@(new FilterBarModel("stays-filter", fields))" />

@if (ViewData["SearchError"] is string error)
{
    <partial name="_Alert" model="@(new AlertModel(error, "danger", Dismissible: false))" />
}

@if (Model.Results.TotalCount == 0)
{
    <partial name="_EmptyState" model='new EmptyStateModel("Không có homestay phù hợp.", "Hãy thử đổi ngày, bớt số khách hoặc chọn khu vực khác.", "house-x", "Xóa bộ lọc", Url.Action("Index"))' />
}
else
{
    <p class="stays-summary" role="status">
        @if (q.HasDates)
        {
            @L["{0} homestay còn phòng từ {1} đến {2}", Model.Results.TotalCount, q.CheckIn!.Value.ToString("dd/MM"), q.CheckOut!.Value.ToString("dd/MM/yyyy")]
        }
        else
        {
            @L["{0} homestay phù hợp. Chọn ngày để xem phòng trống.", Model.Results.TotalCount]
        }
    </p>

    <div class="fx-homestay-grid">
        @foreach (var h in Model.Results)
        {
            <partial name="_HomestayCard" model="@HomestayCardModel.From(h, q)" />
        }
    </div>
    <partial name="_Pager" model="Model.Results" />
}

@section Scripts {
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/vn.min.js"></script>
    <script src="~/js/components/date-range-picker.js" asp-append-version="true"></script>
    <script src="~/js/components/guest-picker.js" asp-append-version="true"></script>
}
