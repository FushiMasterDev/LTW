@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Không có quyền truy cập"];
}
<div class="status-page">
    <div class="status-code" aria-hidden="true">403</div>
    <h1 class="h3 mt-2">@L["Không có quyền truy cập"]</h1>
    <p class="text-muted">@L["Tài khoản của bạn không được phép xem trang này."]</p>
    <a class="btn btn-brand" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door" aria-hidden="true"></i> @L["Về trang chủ"]</a>
</div>
