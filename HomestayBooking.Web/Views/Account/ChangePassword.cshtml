@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Đổi mật khẩu"];
}
<div class="form-panel">
    <h1>@L["Đổi mật khẩu"]</h1>
    <form asp-action="ChangePassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
        <form-field asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        <form-field asp-for="NewPassword" type="password" autocomplete="new-password" hint="@L["Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt."]" />
        <form-field asp-for="ConfirmPassword" type="password" autocomplete="new-password" wrapper="mb-4" />
        <button type="submit" class="btn btn-brand btn-lg w-100" data-loading-text="@L["Đang lưu..."]">@L["Lưu"]</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
