@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Đổi mật khẩu"];
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card-soft narrow-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="icon-chip" aria-hidden="true"><i class="bi bi-key"></i></span>
                <h1 class="h4 mb-0">@L["Đổi mật khẩu"]</h1>
            </div>
            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="newPasswordHelp" />
                    <div id="newPasswordHelp" class="form-text">@L["Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt."]</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-brand w-100" data-loading-text="@L["Đang lưu..."]">
                    <i class="bi bi-check2" aria-hidden="true"></i> @L["Lưu"]
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
