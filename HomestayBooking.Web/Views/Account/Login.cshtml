@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Đăng nhập"];
}
<div class="auth-card">
    <partial name="_AuthAside" model="@(new AuthAsideModel("Chào mừng đến Fuji Homestay", ["Khách hàng: theo dõi đơn đặt phòng của bạn.", "Chủ homestay: quản lý phòng, lịch và đơn đặt.", "Một tài khoản dùng chung cho cả hai vai trò."]))" />
    <div class="auth-form">
        <h1>@L["Đăng nhập"]</h1>
        <p class="auth-form__lead">@L["Dành cho khách hàng và chủ homestay. Đăng nhập bằng số điện thoại đã đăng ký."]</p>
        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <form-field asp-for="PhoneNumber" type="tel" autocomplete="username" inputmode="tel" placeholder="09xx xxx xxx" autofocus="true" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#Password"
                            aria-label="@L["Hiện mật khẩu"]" data-label-show="@L["Hiện mật khẩu"]" data-label-hide="@L["Ẩn mật khẩu"]"><icon name="eye" /></button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <form-field asp-for="RememberMe" wrapper="mb-4" />
            <button type="submit" class="btn btn-brand w-100 btn-lg" data-loading-text="@L["Đang đăng nhập..."]">@L["Đăng nhập"]</button>
        </form>
        <p class="auth-form__foot">@L["Chưa có tài khoản?"] <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@L["Đăng ký bằng số điện thoại"]</a></p>
        <p class="auth-form__foot">@L["Nhân viên Fuji?"] <a asp-action="EmployeeLogin" asp-route-returnUrl="@Model.ReturnUrl">@L["Đăng nhập bằng mã nhân viên"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
