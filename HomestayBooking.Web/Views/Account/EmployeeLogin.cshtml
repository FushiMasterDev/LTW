@model EmployeeLoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Cổng nhân viên Fuji"];
}
<div class="auth-card">
    <partial name="_AuthAside" model="@(new AuthAsideModel("Cổng nội bộ Fuji", ["Nhân viên tư vấn: tra phòng trống, tạo đơn thay khách.", "Kế toán: xác nhận cọc, đối soát.", "Quản lý: danh mục, duyệt chủ homestay, báo cáo."]))" />
    <div class="auth-form">
        <h1>@L["Cổng nhân viên Fuji"]</h1>
        <p class="auth-form__lead">@L["Đăng nhập bằng mã nhân viên do Fuji cấp."]</p>
        <form asp-action="EmployeeLogin" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <form-field asp-for="EmployeeCode" autocomplete="username" placeholder="NV001" autofocus="true" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#Password"
                            aria-label="@L["Hiện mật khẩu"]" data-label-show="@L["Hiện mật khẩu"]" data-label-hide="@L["Ẩn mật khẩu"]"><icon name="eye" /></button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <form-field asp-for="RememberMe" wrapper="mb-4" />
            <button type="submit" class="btn btn-brand w-100 btn-lg" data-loading-text="@L["Đang đăng nhập..."]">@L["Đăng nhập"]</button>
        </form>
        <p class="auth-form__foot"><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl"><icon name="arrow-left" /> @L["Khách hàng / chủ homestay đăng nhập bằng số điện thoại"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
