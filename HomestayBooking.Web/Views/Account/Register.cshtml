@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Đăng ký"];
}
<div class="auth-card">
    <partial name="_AuthAside" model="@(new AuthAsideModel("Tạo tài khoản khách hàng", ["Đặt phòng và thanh toán cọc bằng QR.", "Theo dõi mọi đơn đặt phòng ở một nơi.", "Đơn đã đặt qua tổng đài sẽ tự hiện nếu dùng cùng số điện thoại."]))" />
    <div class="auth-form">
        <h1>@L["Đăng ký"]</h1>
        <p class="auth-form__lead">@L["Số điện thoại là tên đăng nhập của bạn."]</p>
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <form-field asp-for="FullName" autocomplete="name" autofocus="true" />
            <form-field asp-for="PhoneNumber" type="tel" autocomplete="username" inputmode="tel" placeholder="09xx xxx xxx" />
            <form-field asp-for="Email" type="email" autocomplete="email" />
            <div class="row g-3">
                <div class="col-sm-6"><form-field asp-for="Password" type="password" autocomplete="new-password" wrapper="mb-0" /></div>
                <div class="col-sm-6"><form-field asp-for="ConfirmPassword" type="password" autocomplete="new-password" wrapper="mb-0" /></div>
            </div>
            <p class="form-text mt-2 mb-4">@L["Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt."]</p>
            <button type="submit" class="btn btn-brand w-100 btn-lg" data-loading-text="@L["Đang tạo tài khoản..."]">@L["Đăng ký"]</button>
        </form>
        <p class="auth-form__foot">@L["Đã có tài khoản?"] <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Đăng nhập"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
