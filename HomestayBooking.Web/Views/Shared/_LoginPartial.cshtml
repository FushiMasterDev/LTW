@using HomestayBooking.Web.Identity
@if (User.Identity?.IsAuthenticated == true)
{
    var displayName = User.DisplayName();
    var initial = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?[..1].ToUpper() ?? "?";
    var compact = ViewData["UserMenuCompact"] is true;
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle ps-2" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                aria-label="@L["Tài khoản"]: @displayName">
            <span class="avatar" aria-hidden="true">@initial</span>
            <span class="text-truncate user-menu-name @(compact ? "d-none d-md-inline" : "")">@displayName</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            @if (!User.IsActiveEmployee())
            {
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Bookings" asp-action="Mine">
                        <i class="bi bi-receipt" aria-hidden="true"></i> @L["Đơn của tôi"]
                    </a>
                </li>
            }
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                    <i class="bi bi-key" aria-hidden="true"></i> @L["Đổi mật khẩu"]
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i> @L["Đăng xuất"]
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="btn btn-outline-secondary" asp-area="" asp-controller="Account" asp-action="Register">
        @L["Đăng ký"]
    </a>
    <a class="btn btn-brand" asp-area="" asp-controller="Account" asp-action="Login">
        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> @L["Đăng nhập"]
    </a>
}
