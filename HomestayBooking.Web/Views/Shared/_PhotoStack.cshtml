@model PhotoStackModel
@if (Model.Homes.Any(h => !string.IsNullOrWhiteSpace(h.CoverUrl)))
{
    <div class="fx-photo-stack" data-autoplay="ambient" role="region" aria-label="@L["Homestay của đối tác"]">
        <div class="fx-photo-stack__photos">
            @foreach (var home in Model.Homes.Where(h => !string.IsNullOrWhiteSpace(h.CoverUrl)).Take(3))
            {
                <a asp-controller="Homestays" asp-action="Details" asp-route-id="@home.Id"><img src="@(home.CoverUrl!.Thumbnail())" alt="@home.Name" width="480" height="360" loading="lazy" decoding="async" /></a>
            }
        </div>
        <partial name="_MotionControls" model="false" />
    </div>
}
