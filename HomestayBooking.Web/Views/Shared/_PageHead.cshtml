@model PageHeadModel
@{
    var routes = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
    if (Model.RouteValues is not null) { foreach (var pair in Model.RouteValues) { routes[pair.Key] = pair.Value; } }
    if (Model.Area is not null) { routes["area"] = Model.Area; }
}
<div class="fx-page-head">
    <div class="mw-100 text-break">
            <h1>@if (!string.IsNullOrEmpty(Model.Icon)) { <icon name="@Model.Icon" /> } @L[Model.Title]</h1>
            @if (!string.IsNullOrEmpty(Model.Subtitle))
            {
                    <p class="text-muted mb-0">@L[Model.Subtitle]</p>
            }
    </div>
    @if (Model.ShowCreate)
    {
        <a class="btn btn-brand" href="@Url.Action(Model.Action, Model.Controller, routes)"><icon name="plus-lg" /> @L[Model.ActionLabel]</a>
    }
</div>
