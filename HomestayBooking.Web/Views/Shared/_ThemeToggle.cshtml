@* Nút đổi sáng/tối; nhãn được site.js cập nhật theo chế độ hiện tại *@
<button type="button" class="btn @(ViewData["ThemeToggleClass"] ?? "btn-outline-secondary") theme-toggle" data-theme-toggle
        aria-label="@L["Bật chế độ tối"]" title="@L["Bật chế độ tối"]"
        data-label-dark="@L["Bật chế độ tối"]" data-label-light="@L["Bật chế độ sáng"]">
    <i class="bi bi-moon-stars" aria-hidden="true"></i>
    <i class="bi bi-sun" aria-hidden="true"></i>
</button>
