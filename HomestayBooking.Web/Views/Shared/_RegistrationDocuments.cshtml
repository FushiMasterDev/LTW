@using HomestayBooking.Web.Services
@model IReadOnlyList<RegistrationDocument>
@if(Model.Count==0){<partial name="_EmptyState" model='new EmptyStateModel("Chưa có giấy tờ.")' />}
else {
 <ul class="list-unstyled mt-3">
 @foreach(var d in Model){<li class="mb-3"><a class="btn btn-outline-secondary" asp-area="Staff" asp-controller="OwnerRegistrations" asp-action="Document" asp-route-id="@d.Id">@L[d.Type switch {DocumentType.BusinessLicense=>"Giấy phép kinh doanh",DocumentType.FireSafety=>"Giấy PCCC",DocumentType.PropertyPhoto=>"Ảnh thực tế",_=>"Giấy tờ khác"}] · @(d.OriginalFileName ?? L["Xem giấy tờ"].Value)</a>
 @if(d.Expired){<span class="badge-tone tone-rose">@L["Hết hạn"]</span>}
 @if(d.ExpiryDate is {} expiry){<span class="text-muted">@L["Hạn {0}",expiry.ToString("dd/MM/yyyy")]</span>}
 </li>}
 </ul>
}
