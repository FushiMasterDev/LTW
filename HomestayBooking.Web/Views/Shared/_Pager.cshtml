@model IPaginatedList
@*
    Phân trang dùng chung. Giữ nguyên mọi tham số query hiện tại (bộ lọc, từ khóa), chỉ thay "page".
    Dùng: <partial name="_Pager" model="Model" />
*@
@{
    const int window = 2;
    var first = Math.Max(1, Model.PageIndex - window);
    var last = Math.Min(Model.TotalPages, Model.PageIndex + window);
    var fromItem = Model.TotalCount == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var toItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);

    // Key route bị bỏ qua để query string không đổi được controller/action của link
    var reserved = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "page", "area", "controller", "action", "handler" };

    Dictionary<string, string> RouteFor(int page)
    {
        var values = Context.Request.Query
            .Where(q => !reserved.Contains(q.Key))
            .ToDictionary(q => q.Key, q => q.Value.ToString());
        values["page"] = page.ToString();
        return values;
    }
}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 mt-3">
    <small class="text-muted">@L["Hiển thị {0}–{1} trên tổng {2}", fromItem, toItem, Model.TotalCount]</small>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="@L["Phân trang"]">
            <ul class="pagination pagination-sm mb-0">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item"><a class="page-link" asp-all-route-data="RouteFor(Model.PageIndex - 1)" aria-label="@L["Trang trước"]">&laquo;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                }
                @if (first > 1)
                {
                    <li class="page-item"><a class="page-link" asp-all-route-data="RouteFor(1)">1</a></li>
                    @if (first > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                @for (var p = first; p <= last; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")" aria-current="@(p == Model.PageIndex ? "page" : null)">
                        <a class="page-link" asp-all-route-data="RouteFor(p)">@p</a>
                    </li>
                }
                @if (last < Model.TotalPages)
                {
                    @if (last < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" asp-all-route-data="RouteFor(Model.TotalPages)">@Model.TotalPages</a></li>
                }
                @if (Model.HasNextPage)
                {
                    <li class="page-item"><a class="page-link" asp-all-route-data="RouteFor(Model.PageIndex + 1)" aria-label="@L["Trang sau"]">&raquo;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
                }
            </ul>
        </nav>
    }
</div>
