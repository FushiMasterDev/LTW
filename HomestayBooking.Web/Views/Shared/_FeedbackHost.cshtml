<div class="modal fade" id="fx-confirm-dialog" tabindex="-1" aria-labelledby="fx-confirm-title" aria-describedby="fx-confirm-message" aria-hidden="true" data-default-title="@L["Xác nhận thao tác"]">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title h5" id="fx-confirm-title">@L["Xác nhận thao tác"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Đóng"]"></button></div>
        <div class="modal-body" id="fx-confirm-message"></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Hủy"]</button><button type="button" class="btn btn-brand" data-confirm-accept>@L["Xác nhận"]</button></div>
    </div></div>
</div>
<div id="fx-toast-host" class="toast-container position-fixed top-0 end-0 p-3 fx-toasts" aria-live="polite" aria-atomic="false" data-close-label="@L["Đóng"]" data-title="@L["Thông báo"]"></div>
