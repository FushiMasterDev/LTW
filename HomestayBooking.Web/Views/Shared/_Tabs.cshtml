@model TabsModel
<nav class="fx-tabs" aria-label="@L[Model.Label]">
    @foreach (var tab in Model.Items.Where(t => t.Visible))
    {
        <a class="fx-tabs__link @(tab.Active ? "is-active" : null)" href="@Url.Content("~" + tab.Href)" aria-current="@(tab.Active ? "page" : null)">
            @if (tab.Icon is not null) { <icon name="@tab.Icon" /> } @L[tab.Label]
            @if (tab.Count > 0) { <span class="fx-tabs__count">@tab.Count</span> }
        </a>
    }
</nav>
