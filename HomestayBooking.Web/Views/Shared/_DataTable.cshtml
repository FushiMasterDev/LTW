@model DataTableModel
@{
    var actions = Model.Rows.Any(r => r.Actions is not null);
}
<div class="fx-table-wrap">
    <table class="table fx-table">
        <caption class="visually-hidden">@L[Model.Caption]</caption>
        <thead><tr>
            @foreach (var column in Model.Columns)
            {
                var selected = column.SortKey is not null && string.Equals(Context.Request.Query["sort"], column.SortKey, StringComparison.OrdinalIgnoreCase);
                <th scope="col" class="@(column.Numeric ? "text-end" : null) @(column.NoWrap ? "fx-table__nowrap" : null)" aria-sort="@(selected ? (Context.Request.Query["dir"] == "desc" ? "descending" : "ascending") : null)">
                    @if (column.SortKey is { } key)
                    {
                        <a href="@TableSortLink.Build(Context.Request.PathBase + Context.Request.Path, Context.Request.Query, key)">@L[column.Label] <icon name="arrow-down-up" /></a>
                    }
                    else { @L[column.Label] }
                </th>
            }
            @if (actions) { <th scope="col">@L["Thao tác"]</th> }
        </tr></thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @for (var i = 0; i < Model.Columns.Count; i++)
                    {
                        <td data-label="@L[Model.Columns[i].Label]" class="@(Model.Columns[i].Numeric ? "text-end" : null) @(Model.Columns[i].NoWrap ? "fx-table__nowrap" : null)"><div class="fx-table__value">@(i < row.Cells.Count ? row.Cells[i] : null)</div></td>
                    }
                    @if (actions) { <td data-label="@L["Thao tác"]"><div class="fx-table__value">@if (row.Actions is not null) { <partial name="_RowActions" model="row.Actions" /> }</div></td> }
                </tr>
            }
            @if (Model.Rows.Count == 0) {
                <tr><td class="fx-table__empty" colspan="@(Model.Columns.Count + (actions ? 1 : 0))"><partial name="_EmptyState" model="@((Model.Empty ?? new EmptyStateModel()) with { Compact = true })" /></td></tr>
            }
        </tbody>
    </table>

</div>
@if (Model.Pager is not null) { <partial name="_Pager" model="Model.Pager" /> }
