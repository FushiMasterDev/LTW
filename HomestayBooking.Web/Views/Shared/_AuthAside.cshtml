@model AuthAsideModel
@* Cột ảnh trang trí của trang đăng nhập/đăng ký: ảnh trang trí AI (docs/ui/credits.md), chữ trắng trên lớp phủ trung tính. Ẩn trên điện thoại. *@
<div class="auth-aside" data-autoplay="ambient">
    <img src="~/images/ai/auth-veranda.webp" alt="" width="1200" height="1500" decoding="async" />
    <div class="auth-aside__copy">
        <partial name="_MotionControls" model="false" />
        <h2>@L[Model.Title]</h2>
        <ul>
            @foreach (var point in Model.Points) { <li><icon name="check-circle-fill" /> @L[point]</li> }
        </ul>
    </div>
</div>
