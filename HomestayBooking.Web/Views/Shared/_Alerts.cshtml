@if (TempData["Success"] is string success)
{
    <div class="alert tone-emerald alert-dismissible fade show" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
        <div class="flex-grow-1">@success</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Đóng"]"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert tone-rose alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div class="flex-grow-1">@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Đóng"]"></button>
    </div>
}
