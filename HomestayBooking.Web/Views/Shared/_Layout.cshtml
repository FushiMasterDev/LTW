@using Microsoft.AspNetCore.Localization
@{
    var culture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.UICulture.Name ?? "vi-VN";
}
<!DOCTYPE html>
<html lang="@culture[..2]">
<head>
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/layout-public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="site-public d-flex flex-column min-vh-100">
    <a class="skip-link visually-hidden-focusable btn btn-brand" href="#main">@L["Bỏ qua đến nội dung chính"]</a>
    <partial name="_SiteHeader" />

    @await RenderSectionAsync("Hero", required: false)

    <main role="main" id="main" class="@(ViewData["FullWidth"] is true ? "" : "container") flex-grow-1 @(ViewData["MainClass"] ?? "py-4 py-lg-5")" tabindex="-1">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    <partial name="_FeedbackHost" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/motion/reveal.js" asp-append-version="true"></script>
    <script src="~/js/motion/controls.js" asp-append-version="true"></script>
    <script src="~/js/motion/tilt.js" asp-append-version="true"></script>
    <script src="~/js/motion/parallax.js" asp-append-version="true"></script>
    <script src="~/js/motion/flip-lightbox.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
