@model bool
<div class="fx-motion-controls">
    @if (Model)
    {
        <button class="btn btn-outline-secondary" type="button" data-motion-step="-1" aria-label="@L["Trước"]"><icon name="arrow-left" /></button>
    }
    <button class="btn btn-outline-secondary" type="button" data-motion-toggle aria-pressed="false" aria-label="@L["Tạm dừng"]" data-pause="@L["Tạm dừng"]" data-resume="@L["Tiếp tục"]"><icon name="pause-circle" /><span data-motion-label>@L["Tạm dừng"]</span></button>
    @if (Model)
    {
        <button class="btn btn-outline-secondary" type="button" data-motion-step="1" aria-label="@L["Sau"]"><icon name="arrow-right" /></button>
    }
</div>
