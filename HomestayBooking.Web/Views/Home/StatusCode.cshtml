@model int
@{
    Layout = "_AuthLayout";
    var (title, message) = Model switch
    {
        403 => ("Không có quyền truy cập", "Bạn không có quyền xem trang này."),
        404 => ("Không tìm thấy trang", "Trang bạn tìm không tồn tại hoặc đã bị xóa."),
        429 => ("Thử quá nhiều lần", "Bạn đã gửi quá nhiều yêu cầu. Vui lòng chờ rồi thử lại."),
        _ => ("Đã có lỗi xảy ra", "Vui lòng thử lại sau."),
    };
    ViewData["Title"] = L[title];
}
<partial name="_StatusPage" model="@(new StatusPageModel(Model, title, message))" />
