@model HomeIndexViewModel
@{
    ViewData["Title"] = L["Trang chủ"];
    ViewData["MainClass"] = "pt-0 pb-5";
    ViewData["FullWidth"] = true;
    var areas = Model.Areas.Select(a => new SelectListItem(a.Name, a.Id.ToString())).ToList();
    var steps = new (string Title, string Text)[]
    {
        (L["Chọn phòng và ngày"], L["Xem phòng trống và báo giá theo từng đêm."]),
        (L["Đặt và giữ phòng"], L["Đăng ký bằng số điện thoại, phòng được giữ 15 phút cho bạn."]),
        (L["Quét QR đặt cọc 30%"], L["Tiền về là đơn tự cập nhật, homestay xác nhận trong khoảng 30 phút."]),
    };
    var promises = new (string Icon, string Title, string Text)[]
    {
        ("calendar2-check", L["Không lo trùng phòng"], L["Mỗi đêm của mỗi phòng chỉ được giữ cho một đơn đã xác nhận."]),
        ("cash-coin", L["Cọc 30%, hoàn cọc rõ ràng"], L["Hủy trước 7 ngày hoàn 100% cọc, trước 3–6 ngày hoàn 50%."]),
        ("headset", L["Nhân viên tư vấn hỗ trợ"], L["Gọi hotline để nhân viên tìm phòng trống và đặt thay bạn."]),
    };
}

@section Head {
    <link rel="preload" as="image" href="~/images/ai/hero-hanoi.webp" media="(min-width: 768px)" />
    <link rel="preload" as="image" href="~/images/ai/hero-hanoi-mobile.webp" media="(max-width: 767.98px)" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
}

@section Hero {
    <section class="home-hero" data-autoplay="ambient" aria-labelledby="heroTitle">
        <div class="home-hero__scene">
            <div class="home-hero__camera">
                <picture>
                    <source media="(max-width: 767.98px)" srcset="/images/ai/hero-hanoi-mobile.webp" width="1080" height="1350" />
                    <img class="home-hero__photo" src="~/images/ai/hero-hanoi.webp" alt="@L["Hồ nước và mái ngói Hà Nội trong sương bình minh, ảnh trang trí tạo bằng AI"]" width="2400" height="1350" fetchpriority="high" decoding="async" />
                </picture>
            </div>
            <div class="container home-hero__content">
                <div class="home-hero__copy">
                    <span class="home-hero__badge"><icon name="geo-alt" /> @L["{0} homestay tại Hà Nội", Model.HomestayCount]</span>
                    <h1 id="heroTitle"><span>@L["Ngủ giữa phố cổ,"]</span><span>@L["thức cùng"] <em>@L["Hà Nội"].</em></span></h1>
                    <p>@L["Một chốn nghỉ giữa lòng Hà Nội. Chọn ngày, xem phòng trống và bắt đầu chuyến đi của bạn."]</p>
                </div>
                <div class="home-hero__search-depth">
                    <div class="home-search">
                        <partial name="_SearchBar" model="@(new SearchBarModel("home-search", areas, Variant: "hero"))" />
                    </div>
                </div>
            </div>
        </div>
        <span class="home-hero__sentinel" aria-hidden="true"></span>
        <p class="home-hero__credit">@L["Ảnh trang trí tạo bằng AI (ChatGPT)"]</p>
        <button class="home-hero__motion btn btn-light-glass" type="button" data-motion-toggle aria-pressed="false" aria-label="@L["Tạm dừng"]"
                data-pause="@L["Tạm dừng"]" data-resume="@L["Tiếp tục"]">
            <icon name="pause-circle" /><span data-motion-label>@L["Tạm dừng"]</span>
        </button>
    </section>
}

<section class="container home-section home-areas" id="areas" aria-labelledby="areasTitle">
    <div class="home-section__head">
        <div class="home-areas__intro">
            <h2 id="areasTitle">@L["Khám phá khu vực"]</h2>
            <p>@L["Phố cổ, hồ Tây hay đồi núi ngoại thành: chọn khu vực để xem homestay ở đó."]</p>
        </div>
        <a class="btn btn-link" asp-controller="Homestays" asp-action="Index">@L["Xem tất cả"] <icon name="arrow-right" /></a>
    </div>
    <partial name="_AreaCarousel" model="@(new AreaCarouselModel(Model.Areas.Select(area => new AreaCardModel(area.Id, area.Name, area.HomestayCount, area.CoverUrl, area.Group)).ToList()))" />
    <p class="home-areas__note">@L["Đang có {0} homestay với {1} phòng ở {2} khu vực của Hà Nội. Không chọn ngày thì hiện mọi homestay.", Model.HomestayCount, Model.RoomCount, Model.Areas.Count]</p>
</section>

@if (Model.Featured.Count > 0)
{
    <section class="home-section home-featured" aria-labelledby="featuredTitle">
        <div class="container">
        <div class="home-section__head">
            <div>
                <h2 id="featuredTitle">@L["Được khách đánh giá cao"]</h2>
                <p>@L["Xếp theo điểm đánh giá của khách đã ở. Giá là giá ngày thường thấp nhất."]</p>
            </div>
            <a class="btn btn-outline-secondary" asp-controller="Homestays" asp-action="Index">@L["Xem tất cả homestay"]</a>
        </div>
        <div class="fx-homestay-grid">
            @foreach (var h in Model.Featured)
            {
                <partial name="_HomestayCard" model="@HomestayCardModel.From(h)" />
            }
        </div>
        </div>
    </section>
}

<section class="container home-section home-promises" data-autoplay="ambient" aria-labelledby="promisesTitle">
    <h2 id="promisesTitle">@L["Cam kết khi đặt qua Fuji"]</h2>
    <ul class="home-promises__list">
        @foreach (var p in promises)
        {
            <li>
                <icon name="@p.Icon" />
                <div>
                    <h3>@p.Title</h3>
                    <p>@p.Text</p>
                </div>
            </li>
        }
    </ul>
    <partial name="_MotionControls" model="false" />
</section>

<section class="container home-section home-steps" aria-labelledby="stepsTitle">
    <h2 id="stepsTitle">@L["Đặt phòng trong 3 bước"]</h2>
    <partial name="_CardDeck" model="@(new CardDeckModel(steps.Select(step => new MotionStep(step.Title, step.Text)).ToList()))" />
</section>

<div class="container home-section">
<section class="home-partner" aria-labelledby="partnerTitle">
    <div>
        <h2 id="partnerTitle">@L["Có homestay ở Hà Nội?"]</h2>
        <p>@L["Gửi hồ sơ đối tác trực tuyến. Nhân viên Fuji thẩm định trong 3 ngày làm việc."]</p>
    </div>
    <img class="home-partner__decoration" src="~/images/ai/partner-host.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    <partial name="_PhotoStack" model="@(new PhotoStackModel(Model.Featured))" />
    <a class="btn btn-brand btn-lg" asp-controller="Partner" asp-action="Index">@L["Trở thành đối tác"]</a>
</section>
</div>

@section Scripts {
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/vn.min.js"></script>
    <script src="~/js/components/date-range-picker.js" asp-append-version="true"></script>
    <script src="~/js/components/guest-picker.js" asp-append-version="true"></script>
}
