@model HomeIndexViewModel
@{
    ViewData["Title"] = L["Trang chủ"];
    string[] areaTones = ["tone-sky", "tone-emerald", "tone-violet", "tone-orange", "tone-pink", "tone-teal", "tone-amber", "tone-indigo"];
    var features = new (string Icon, string Tone, string Title, string Text)[]
    {
        ("bi-calendar2-check", "tone-sky", L["Không lo trùng phòng"], L["Mỗi đêm của mỗi phòng chỉ được giữ cho một đơn đã xác nhận."]),
        ("bi-cash-coin", "tone-emerald", L["Cọc 30%, hoàn cọc rõ ràng"], L["Hủy trước 7 ngày hoàn 100% cọc, trước 3–6 ngày hoàn 50%."]),
        ("bi-headset", "tone-orange", L["Nhân viên tư vấn hỗ trợ"], L["Gọi hotline để nhân viên tìm phòng trống và đặt thay bạn."]),
    };
    var steps = new (string Tone, string Title, string Text)[]
    {
        ("tone-sky", L["Chọn phòng và ngày"], L["Xem lịch trống và báo giá theo từng đêm."]),
        ("tone-violet", L["Nhập thông tin"], L["Chỉ cần họ tên và số điện thoại, không cần tài khoản."]),
        ("tone-pink", L["Đặt cọc 30%"], L["Chủ homestay xác nhận, bạn chuyển cọc kèm mã đơn."]),
    };
}

<section class="hero mb-4" aria-labelledby="heroTitle">
    <span class="hero-blob b1" aria-hidden="true"></span>
    <span class="hero-blob b2" aria-hidden="true"></span>
    <span class="hero-blob b3" aria-hidden="true"></span>
    <div class="position-relative">
        <span class="hero-badge mb-3"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> @L["Hà Nội, Việt Nam"]</span>
        <h1 id="heroTitle" class="mb-3">@L["Đặt homestay tại Hà Nội, nhanh và rõ ràng"]</h1>
        <p class="lead mb-4">@L["Lịch phòng cập nhật liên tục, báo giá minh bạch theo từng đêm, đặt phòng chỉ cần số điện thoại."]</p>
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a class="btn btn-accent btn-lg" href="tel:19000000"><i class="bi bi-telephone-fill" aria-hidden="true"></i> @L["Gọi tư vấn"] 1900 0000</a>
            <a class="btn btn-light-glass btn-lg" href="#areas"><i class="bi bi-compass" aria-hidden="true"></i> @L["Khám phá khu vực"]</a>
        </div>
        <div class="d-flex flex-wrap gap-4">
            <div class="hero-stat"><strong>@Model.HomestayCount</strong><span>@L["Homestay"]</span></div>
            <div class="hero-stat"><strong>@Model.RoomCount</strong><span>@L["Phòng"]</span></div>
            <div class="hero-stat"><strong>@Model.Areas.Count</strong><span>@L["Khu vực"]</span></div>
        </div>
    </div>
</section>

<div class="row g-3">
    @foreach (var f in features)
    {
        <div class="col-md-4">
            <div class="card-soft card-accent-top feature-card @f.Tone">
                <span class="icon-chip" aria-hidden="true"><i class="bi @f.Icon"></i></span>
                <h2 class="h5 mt-3 mb-1">@f.Title</h2>
                <p class="text-muted mb-0">@f.Text</p>
            </div>
        </div>
    }
</div>

<h2 class="section-title" id="areas"><i class="bi bi-map text-brand" aria-hidden="true"></i> @L["Khám phá khu vực"]</h2>
<div class="row g-3">
    @for (var i = 0; i < Model.Areas.Count; i++)
    {
        var a = Model.Areas[i];
        <div class="col-6 col-md-4 col-lg-3">
            <div class="area-tile @areaTones[i % areaTones.Length]">
                <span class="icon-chip" aria-hidden="true"><i class="bi bi-pin-map-fill"></i></span>
                <div>
                    <strong>@a.Name</strong>
                    <small>@L["{0} homestay", a.HomestayCount]</small>
                </div>
            </div>
        </div>
    }
</div>

<h2 class="section-title"><i class="bi bi-signpost-2 text-brand" aria-hidden="true"></i> @L["Đặt phòng trong 3 bước"]</h2>
<ol class="row g-3 list-unstyled mb-0">
    @for (var i = 0; i < steps.Length; i++)
    {
        var s = steps[i];
        <li class="col-md-4">
            <div class="card-soft step @s.Tone">
                <div class="step-number" aria-hidden="true">@(i + 1)</div>
                <h3 class="h5">@s.Title</h3>
                <p class="text-muted mb-0">@s.Text</p>
            </div>
        </li>
    }
</ol>
