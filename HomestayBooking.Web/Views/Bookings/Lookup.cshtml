@model BookingLookupViewModel
@{
    ViewData["Title"] = L["Tra cứu đơn"];
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card-soft narrow-card">
            <span class="icon-chip icon-chip-lg mb-3" aria-hidden="true"><i class="bi bi-search"></i></span>
            <h1 class="h3 mb-1">@L["Tra cứu đơn"]</h1>
            <p class="text-muted">@L["Dành cho đơn đặt qua tổng đài hoặc khi bạn chưa đăng nhập. Nhập mã đơn (dạng FJ261110-001) và số điện thoại đã dùng khi đặt."]</p>
            <form asp-action="Lookup" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control text-uppercase" placeholder="FJ261110-001" autocomplete="off" autofocus />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" inputmode="tel" placeholder="09xx xxx xxx" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-brand w-100" data-loading-text="@L["Đang tìm..."]"><i class="bi bi-search" aria-hidden="true"></i> @L["Tra cứu"]</button>
            </form>
            <p class="small text-muted mt-4 mb-0">
                @L["Có tài khoản?"] <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Mine", "Bookings")">@L["Đăng nhập để xem mọi đơn của bạn"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
