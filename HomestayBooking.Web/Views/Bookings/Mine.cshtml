@model PaginatedList<MyBookingRow>
@{
    ViewData["Title"] = L["Đơn của tôi"];
    var vouchers = (List<VoucherOption>)ViewBag.Vouchers;
    var tab = (string)ViewBag.Tab;
    var tabs = new TabsModel("Đơn của tôi", [
        new TabItem("Sắp tới", "/Bookings/Mine", tab == "upcoming"),
        new TabItem("Đã qua", "/Bookings/Mine?tab=past", tab == "past"),
        new TabItem("Đã hủy", "/Bookings/Mine?tab=cancelled", tab == "cancelled"),
    ]);
    var empty = tab switch
    {
        "past" => new EmptyStateModel("Chưa có đơn đã qua.", Icon: "clock-history"),
        "cancelled" => new EmptyStateModel("Không có đơn đã hủy.", Icon: "slash-circle"),
        _ => new EmptyStateModel("Bạn chưa có đơn sắp tới.", "Gồm cả đơn nhân viên tư vấn đặt giúp bằng số điện thoại của bạn.", "calendar2-heart", "Tìm homestay", Url.Action("Index", "Homestays")),
    };
}
<div class="stays-head mine-head">
    <div>
        <h1>@L["Đơn của tôi"]</h1>
        <p>@L["Gồm cả đơn nhân viên tư vấn đặt giúp bằng số điện thoại của bạn."]</p>
    </div>
    <a class="btn btn-brand" asp-controller="Homestays" asp-action="Index"><icon name="plus-lg" /> @L["Đặt phòng mới"]</a>
</div>

@if (vouchers.Count > 0)
{
    <section class="mine-vouchers" aria-labelledby="voucherTitle">
        <h2 id="voucherTitle">@L["Voucher của bạn"]</h2>
        <ul>
            @foreach (var v in vouchers)
            {
                <li><span class="booking-code">@v.Code</span> · @L["còn {0:N0}đ, hạn {1}", v.Balance, v.ExpiresOn.ToString("dd/MM/yyyy")]</li>
            }
        </ul>
        <p>@L["Chọn voucher ở bước đặt phòng để được trừ vào tiền cọc."]</p>
    </section>
}

<partial name="_Tabs" model="tabs" />

@if (Model.TotalCount == 0)
{
    <partial name="_EmptyState" model="empty" />
}
else
{
    <ul class="fx-booking-list">
        @foreach (var r in Model)
        {
            <li><partial name="_BookingCard" model="r" /></li>
        }
    </ul>
    <partial name="_Pager" model="Model" />
}
