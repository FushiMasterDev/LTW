@using HomestayBooking.Web.Identity
@using HomestayBooking.Web.Services
@using Microsoft.AspNetCore.Html
@model BookingDetailsViewModel
@{
    var b = Model.Booking;
    ViewData["Title"] = L["Đơn {0}", b.Code];
    string Money(decimal v) => HomestayBooking.Web.TagHelpers.MoneyTagHelper.Format(v);
    IHtmlContent Text(string? value) => new HtmlContentBuilder().Append(value ?? "");
    var polling = b.Status is BookingStatus.AwaitingPayment or BookingStatus.PaymentSubmitted or BookingStatus.Deposited
        || Model.ChangeRequests?.History.Any(h => h.Request.Status is ChangeRequestStatus.Pending or ChangeRequestStatus.AwaitingPayment) == true;
    var hold = DateTime.SpecifyKind(b.HoldExpiresAt, DateTimeKind.Utc);
    // Một thông báo theo trạng thái hiện tại; nội dung đã dịch, _Alert chỉ encode.
    (string Message, string Tone)? notice = b.Status switch
    {
        BookingStatus.AwaitingPayment when Model.QrImageUrl is null => (L["Đã hết thời gian giữ phòng. Hệ thống đang hủy giữ chỗ; nếu bạn vừa chuyển khoản, đơn sẽ tự cập nhật."], "info"),
        BookingStatus.PaymentSubmitted => ($"{L["Fuji đã nhận ảnh bill và đang kiểm tra."]} {L["Phòng vẫn được giữ cho bạn. Bill được duyệt trong giờ hành chính (thứ Hai–thứ Sáu, 8h–17h); bill gửi ngoài giờ sẽ được duyệt vào sáng ngày làm việc kế tiếp."]}", "warning"),
        BookingStatus.Deposited => ($"{L["Fuji đã nhận tiền cọc."]} {L["Homestay sẽ xác nhận đơn trong khoảng 30 phút. Trang này tự cập nhật."]}", "info"),
        BookingStatus.Confirmed => ($"{L["Đơn đã được xác nhận."]} {L["Hẹn gặp bạn ngày {0}.", b.CheckIn.ToString("dd/MM/yyyy")]}", "success"),
        BookingStatus.Expired => (L["Đơn đã hết hạn giữ phòng. Nếu bạn đã chuyển khoản, vui lòng gọi 1900 0000 để được hoàn tiền."], "info"),
        BookingStatus.Rejected => (L["Homestay không nhận được đơn này. Fuji sẽ hoàn 100% tiền cọc ({0}) cho bạn.", Money(b.RefundAmount ?? b.AmountDue)], "danger"),
        BookingStatus.Cancelled => (b.RefundAmount > 0 ? $"{L["Đơn đã hủy."]} {L["Số tiền hoàn: {0}.", Money(b.RefundAmount.Value)]}" : L["Đơn đã hủy."], "info"),
        _ => null,
    };
    var summary = new List<DescriptionItem>
    {
        new("Khu vực", Text(b.Homestay.Area.Name)),
        new("Loại phòng", Text(b.RoomType.Name)),
        new("Ngày ở", new HtmlContentBuilder().AppendHtml($"<span class=\"fx-date-range\">{b.CheckIn:dd/MM/yyyy} – {b.CheckOut:dd/MM/yyyy}</span>").Append($" ({L["{0} đêm", b.CheckOut.DayNumber - b.CheckIn.DayNumber]})")),
        new("Số khách", Text(b.Guests.ToString())),
        new("Người nhận phòng", Text($"{b.ContactName} · {PhoneNumberNormalizer.ToNational(b.ContactPhone)}")),
    };
    if (!string.IsNullOrEmpty(b.SpecialRequests)) summary.Add(new("Yêu cầu đặc biệt", Text(b.SpecialRequests)));
    var prices = b.Nights.OrderBy(n => n.Date).Select(n => new PriceLine(n.Date.ToString("dd/MM (ddd)"), n.Price))
        .Append(new PriceLine("Tổng tiền phòng", b.TotalAmount))
        .Append(new PriceLine(L["Tiền cọc ({0:P0})", b.DepositRate], b.DepositAmount)).ToList();
    if (b.DiscountAmount > 0)
    {
        prices.Add(new PriceLine(L["Giảm từ voucher {0}", b.Voucher?.Code ?? ""], -b.DiscountAmount));
        prices.Add(new PriceLine("Cọc cần chuyển", b.AmountDue));
    }
    prices.Add(new PriceLine("Thanh toán tại homestay", b.TotalAmount - b.DepositAmount));
}

<header class="order-header">
    <div>
        <p>@L["Mã đơn"]</p>
        <h1 class="booking-code">@b.Code</h1>
    </div>
    <status-badge value="b.Status" icon="true" />
</header>

<div class="order-stepper">
    <partial name="_BookingStepper" model="@(new BookingStepperModel(b.Status))" />
</div>

@if (notice is { } n)
{
    <partial name="_Alert" model="@(new AlertModel(n.Message, n.Tone, Dismissible: false))" />
}
@if (b.Status == BookingStatus.PaymentSubmitted && Model.PendingReceipt is not null)
{
    <p><a asp-action="Receipt" asp-route-paymentId="@Model.PendingReceipt.Id" target="_blank" rel="noopener">@L["Xem ảnh đã gửi"]</a></p>
}

<div class="booking-layout">
    <div class="booking-layout__main">
        @if (Model.QrImageUrl is not null)
        {
            <section class="booking-section" aria-labelledby="payTitle">
                <h2 id="payTitle">@L["Chuyển khoản tiền cọc"]</h2>
                @if (Model.LastRejectedReceipt is not null)
                {
                    <partial name="_Alert" model="@(new AlertModel(L["Ảnh bill trước chưa hợp lệ: {0}. Vui lòng thanh toán lại hoặc gửi ảnh khác.", Model.LastRejectedReceipt.RejectReason ?? ""], "danger", Dismissible: false))" />
                }
                <partial name="_PaymentQr" model="@(new PaymentQrModel(Model.QrImageUrl, b.AmountDue, b.Code, hold, Model.Bank, ReloadOnExpiry: true))" />
                <ol class="order-pay-steps">
                    <li>@L["Mở app ngân hàng, quét mã QR (số tiền và nội dung đã điền sẵn)."]</li>
                    <li>@L["Giữ nguyên nội dung chuyển khoản là mã đơn để hệ thống tự xác nhận."]</li>
                    <li>@L["Trang này tự cập nhật khi Fuji nhận được tiền, thường trong 1–2 phút."]</li>
                </ol>

                @if (Model.CanUploadReceipt)
                {
                    <details class="order-receipt">
                        <summary>@L["Đã chuyển khoản nhưng sau vài phút trang vẫn chưa cập nhật?"]</summary>
                        <form asp-action="UploadReceipt" asp-route-id="@b.Code" method="post" enctype="multipart/form-data">
                            <p>@L["Gửi ảnh chụp màn hình giao dịch để kế toán kiểm tra. Phòng vẫn được giữ trong lúc chờ duyệt. Bill gửi ngoài giờ hành chính sẽ được duyệt vào sáng hôm sau."]</p>
                            <partial name="_UploadZone" model="@(new UploadZoneModel("receipt", "receipt", AllowPdf: false))" />
                            <div class="my-3">
                                <label class="form-label" for="transferContent">@L["Nội dung bạn đã ghi khi chuyển khoản (nếu nhớ)"]</label>
                                <input class="form-control" id="transferContent" name="transferContent" maxlength="200" />
                            </div>
                            <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang gửi..."]">@L["Gửi ảnh bill"]</button>
                        </form>
                    </details>
                }

                @if (Model.ShowDevSimulator)
                {
                    <div class="alert tone-amber small mt-3 mb-0">
                        <icon name="bug" />
                        <div><strong>Development:</strong> @L["Giả lập tiền về cho đơn này (cần đăng nhập quản lý, nên mở ở cửa sổ ẩn danh):"]
                            <a asp-controller="Dev" asp-action="SimulateBank" asp-route-code="@b.Code" asp-route-amount="@decimal.ToInt64(b.AmountDue)" target="_blank" rel="noopener">@L["Mở trang giả lập"]</a></div>
                    </div>
                }
            </section>
        }

        @if (Model.ShowAddress)
        {
            var checkin = new List<DescriptionItem>
            {
                new("Địa chỉ", Text(b.Homestay.Address)),
                new("Số phòng", Text(b.Room.RoomCode)),
                new("Giờ nhận / trả phòng", Text($"{b.Homestay.CheckinTime:HH:mm} / {b.Homestay.CheckoutTime:HH:mm}")),
            };
            if (b.Homestay.ContactPhone is string phone)
            {
                checkin.Insert(2, new("Điện thoại homestay", new HtmlContentBuilder().AppendHtml("<a href=\"tel:").Append(phone).AppendHtml("\">").Append(PhoneNumberNormalizer.ToNational(phone)).AppendHtml("</a>")));
            }
            <section class="booking-section" aria-labelledby="checkinTitle">
                <h2 id="checkinTitle">@L["Thông tin nhận phòng"]</h2>
                <partial name="_DescriptionList" model="checkin" />
                @if (!string.IsNullOrEmpty(b.Homestay.CheckinGuideHtml))
                {
                    <div class="rich-text mt-3">@Html.Raw(b.Homestay.CheckinGuideHtml)</div>
                }
            </section>
        }

        @if (b.Status == BookingStatus.Completed)
        {
            <section class="booking-section" id="review" aria-labelledby="reviewTitle">
                <h2 id="reviewTitle">@L["Đánh giá của bạn"]</h2>
                @if (Model.Review is { } review)
                {
                    <div class="order-review">
                        <rating value="review.Rating" single="true" />
                        @if (!string.IsNullOrEmpty(review.Comment)) { <p>@review.Comment</p> }
                        @if (!string.IsNullOrEmpty(review.OwnerReply))
                        {
                            <div class="stay-reviews__reply">
                                <p class="fw-semibold mb-1">@L["Chủ homestay trả lời"]</p>
                                <p>@review.OwnerReply</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="booking-section__lead">@L["Chia sẻ trải nghiệm để khách sau chọn phòng dễ hơn. Mỗi đơn được đánh giá một lần."]</p>
                    <form asp-action="Review" asp-route-id="@b.Code" method="post">
                        <partial name="_RatingInput" model="@(new RatingInputModel("review-rating"))" />
                        <div class="my-3">
                            <label class="form-label" for="reviewComment">@L["Nhận xét (không bắt buộc)"]</label>
                            <textarea class="form-control" id="reviewComment" name="comment" rows="4" maxlength="1000"></textarea>
                        </div>
                        @if (!Model.IsOwnAccount)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="reviewPhone">@L["Số điện thoại đặt phòng"]</label>
                                <input class="form-control" id="reviewPhone" name="phoneNumber" type="tel" inputmode="tel" autocomplete="tel" required />
                                <p class="form-text">@L["Nhập lại số điện thoại đã dùng khi đặt để xác nhận bạn là khách của đơn."]</p>
                            </div>
                        }
                        <button type="submit" class="btn btn-brand" data-loading-text="@L["Đang gửi..."]">@L["Gửi đánh giá"]</button>
                    </form>
                }
            </section>
        }

        <partial name="_CustomerChanges" model="Model" />

        @if (Model.CanCancel && Model.CancelQuote is { } refund)
        {
            <section class="booking-section" aria-labelledby="cancelTitle">
                <h2 id="cancelTitle">@L["Hủy đơn"]</h2>
                @if (b.Status is BookingStatus.Deposited or BookingStatus.Confirmed)
                {
                    <p>@L["Hủy hôm nay (còn {0} ngày trước ngày nhận phòng): hoàn {1}% tiền cọc = {2}.", refund.DaysBefore, refund.RefundPercent, Money(refund.RefundAmount)]</p>
                    <partial name="_PriceBreakdown" model="@(new PriceBreakdownModel([new PriceLine("Tiền cọc", b.AmountDue), new PriceLine("Tiền hoàn khi hủy", refund.RefundAmount)]))" />
                }
                else
                {
                    <p>@L["Đơn chưa có tiền cọc nên hủy không mất phí."]</p>
                }
                <form asp-action="Cancel" asp-route-id="@b.Code" method="post" class="mt-3" data-confirm="@L["Bạn chắc chắn muốn hủy đơn {0}?", b.Code]">
                    <label class="form-label" for="cancelReason">@L["Lý do hủy (không bắt buộc)"]</label>
                    <div class="input-group">
                        <input class="form-control" id="cancelReason" name="reason" maxlength="200" />
                        <button type="submit" class="btn btn-outline-danger">@L["Hủy đơn"]</button>
                    </div>
                </form>
            </section>
        }
    </div>

    <aside class="booking-layout__aside">
        <section class="booking-summary" aria-labelledby="summaryTitle">
            <h2 id="summaryTitle">@b.Homestay.Name</h2>
            <partial name="_DescriptionList" model="summary" />
            <h3>@L["Chi tiết giá"]</h3>
            <partial name="_PriceBreakdown" model="@(new PriceBreakdownModel(prices))" />
        </section>
        @if (Model.IsOwnAccount)
        {
            <a class="btn btn-outline-secondary mt-3" asp-action="Mine"><icon name="arrow-left" /> @L["Đơn của tôi"]</a>
        }
    </aside>
</div>

@section Scripts {
    <script src="~/js/components/payment-qr.js" asp-append-version="true"></script>
    <script src="~/js/components/upload-zone.js" asp-append-version="true"></script>
    @if (polling)
    {
        <script>
            (() => {
                // Tự tải lại khi trạng thái đơn đổi (tiền về, homestay xác nhận, hết hạn)
                const initial = @Json.Serialize(b.Status.ToString());
                const version = @Json.Serialize(ChangeRequestUiService.Version(Model.ChangeRequests?.History.Select(h => h.Request) ?? []));
                const statusUrl = '@Url.Action("Status", new { id = b.Code })';
                setInterval(async () => {
                    if (document.hidden) return;
                    try {
                        const res = await fetch(statusUrl, { cache: 'no-store' });
                        if (res.ok) {
                            const state = await res.json();
                            if (state.status !== initial || state.changeVersion !== version) location.reload();
                        }
                    } catch { /* mất mạng tạm thời: lần sau thử lại */ }
                }, 5000);
            })();
        </script>
    }
}
