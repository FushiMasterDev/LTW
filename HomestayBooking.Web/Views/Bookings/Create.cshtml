@using HomestayBooking.Web.Services
@inject TimeProvider Clock
@model BookingCreateViewModel
@{
    ViewData["Title"] = L["Đặt phòng"];
    var today = VietnamTime.Today(Clock);
    string DayLabel(DayType type) => type switch { DayType.Weekend => L["Cuối tuần"], DayType.Holiday => L["Ngày lễ"], _ => L["Ngày thường"] };
    var vouchers = Model.Vouchers.Select(v => new SelectListItem($"{v.Code} · {L["còn {0:N0}đ, hạn {1}", v.Balance, v.ExpiresOn.ToString("dd/MM/yyyy")]}", v.Id.ToString())).ToList();
    string? Error(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
    var lines = Model.Quote is { } quote
        ? quote.Nights.Select(n => new PriceLine($"{n.Date:dd/MM (ddd)} · {DayLabel(n.DayType)}", n.Price))
            .Append(new PriceLine("Tổng tiền phòng", quote.Total)).Append(new PriceLine("Cọc cần thanh toán ngay", quote.Deposit)).ToList()
        : null;
    var blockedUrl = Url.Action("BlockedDates", "Homestays", new { roomTypeId = Model.RoomTypeId, from = today.ToString("yyyy-MM-dd"), to = today.AddDays(92).ToString("yyyy-MM-dd") });
    var text = new Dictionary<string, string>
    {
        ["total"] = L["Tổng tiền phòng"], ["deposit"] = L["Cọc (30%)"], ["discount"] = L["Giảm từ voucher"],
        ["due"] = L["Cọc cần thanh toán ngay"], ["free"] = L["Còn {0} phòng trống"], ["soldOut"] = L["Hết phòng trong thời gian này."],
        ["failed"] = L["Không tải được giá, vui lòng thử lại."],
    };
}

@section Head {
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
}

<partial name="_Breadcrumb" model="@(new BreadcrumbModel([new BreadcrumbItem("Tìm homestay", Url.Action("Index", "Homestays"), HideOnMobile: true), new BreadcrumbItem(Model.HomestayName, Url.Action("Details", "Homestays", new { id = Model.HomestayId })), new BreadcrumbItem("Đặt phòng")]))" />

<header class="booking-head">
    <h1>@L["Đặt phòng"]</h1>
    <p>@Model.HomestayName · <strong>@Model.RoomTypeName</strong> · @L["Tối đa {0} khách", Model.MaxGuests]</p>
</header>

<form asp-action="Create" method="post" novalidate id="bookingForm" class="booking-layout">
    <input type="hidden" asp-for="RoomTypeId" />
    <div class="booking-layout__main">
        <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>

        <section class="booking-section" aria-labelledby="stayTitle">
            <h2 id="stayTitle">@L["Thời gian lưu trú"]</h2>
            <partial name="_DateRangePicker" model="@(new DateRangePickerModel("booking-dates", Model.CheckIn, Model.CheckOut, BlockedUrl: blockedUrl, Error: Error("CheckIn") ?? Error("CheckOut")))" />
            <div class="booking-section__guests">
                <partial name="_GuestPicker" model="@(new GuestPickerModel("Guests", Value: Model.Guests, Max: Model.MaxGuests, Error: Error("Guests")))" />
            </div>
        </section>

        <section class="booking-section" aria-labelledby="contactTitle">
            <h2 id="contactTitle">@L["Người nhận phòng"]</h2>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p class="booking-section__lead">@L["Không cần tài khoản: Fuji dùng số điện thoại để gửi thông tin đơn và để bạn tra cứu đơn sau này."]</p>
            }
            <div class="row g-3">
                <div class="col-sm-6"><form-field asp-for="ContactName" autocomplete="name" wrapper="mb-0" /></div>
                <div class="col-sm-6"><form-field asp-for="ContactPhone" type="tel" inputmode="tel" autocomplete="tel" wrapper="mb-0" /></div>
                <div class="col-12"><form-field asp-for="SpecialRequests" type="textarea" rows="3" placeholder="@L["Ví dụ: nhận phòng muộn, cần nôi em bé..."]" wrapper="mb-0" /></div>
            </div>
        </section>
    </div>

    <aside class="booking-layout__aside">
        <div class="booking-summary">
            <h2>@L["Chi tiết giá"]</h2>
            <div id="quoteBox" aria-live="polite" data-booking-quote data-quote-url="@Url.Action("Quote")" data-room-type="@Model.RoomTypeId" data-text="@System.Text.Json.JsonSerializer.Serialize(text)">
                @if (lines is null)
                {
                    <p class="text-muted mb-0">@L["Chọn ngày để xem giá."]</p>
                }
                else
                {
                    <partial name="_PriceBreakdown" model="@(new PriceBreakdownModel(lines))" />
                }
            </div>
            @if (Model.Vouchers.Count > 0)
            {
                <div class="mt-3">
                    <form-field asp-for="VoucherId" type="select" placeholder="@L["Không dùng"]" asp-items="vouchers" hint="@L["Mỗi đơn được giảm một phần, số dư còn lại dùng cho lần sau."]" wrapper="mb-0" />
                </div>
            }
            <partial name="_Alert" model="@(new AlertModel("Sau khi bấm đặt, phòng được giữ 15 phút để bạn chuyển khoản tiền cọc qua mã QR. Phần còn lại thanh toán tại homestay.", "warning", Dismissible: false))" />
            <button type="submit" class="btn btn-brand btn-lg w-100" data-loading-text="@L["Đang giữ phòng..."]">@L["Đặt và giữ phòng"]</button>
        </div>
    </aside>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/vn.min.js"></script>
    <script src="~/js/components/date-range-picker.js" asp-append-version="true"></script>
    <script src="~/js/components/guest-picker.js" asp-append-version="true"></script>
    <script src="~/js/components/booking-quote.js" asp-append-version="true"></script>
}
