@model SimulateBankViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = L["Giả lập tiền vào"]; }
<partial name="_PageHead" model='new PageHeadModel("Giả lập tiền vào tài khoản MB", "", "", ShowCreate: false)' />
<partial name="_Breadcrumb" model='new BreadcrumbModel(new BreadcrumbItem[] { new("Kế toán", Url.Action("Index", "Dashboard", new { area = "Accounting" })), new("Giả lập tiền vào") })' />
<div class="fx-card fx-form-card">
    <p class="text-muted small">@L["Tạo một giao dịch tiền vào giống webhook SePay, đi qua đúng logic tự khớp. Chỉ có ở môi trường Development."]</p>
    <form asp-action="SimulateBank" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
        <form-field asp-for="Content" placeholder="FJ261110-001 dat coc" />
        <form-field asp-for="Amount" type="number" step="1000" hint="@L["Thử nhập thiếu tiền (Underpaid) hoặc dư tiền để xem các trường hợp."]" />
        <form-field asp-for="AccountNumber" hint="@L["Đổi số khác để thử trường hợp sai tài khoản (Ignored)."]" />
        <div class="fx-form-actions"><button type="submit" class="btn btn-brand" data-loading-text="@L["Đang xử lý..."]"><icon name="cash-coin" /> @L["Gửi giao dịch"]</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
