@using Microsoft.AspNetCore.Html
@using HomestayBooking.Web.TagHelpers
@using HomestayBooking.Web.Services
@inject VietQrService VietQr
@model UiKitViewModel
@{
    // Trang công cụ cho nhóm phát triển (giống SimulateBank): chữ mô tả không đưa vào resource; component bên trong vẫn tự dịch.
    Layout = "_DashboardLayout";
    ViewData["Title"] = "UI Kit";
    var today = VietnamTime.Today(TimeProvider.System);
    var sections = new (string Id, string Title)[]
    {
        ("colors", "Màu"), ("type", "Chữ"), ("buttons", "Nút"), ("badges", "Badge trạng thái"), ("money", "Tiền và ngày"),
        ("icons", "Icon"), ("forms", "Form"), ("alerts", "Thông báo"), ("lists", "Trang danh sách"), ("empty", "Trạng thái rỗng"), ("layout", "Khung trang"), ("rating", "Điểm đánh giá"), ("stats", "Ô số liệu"), ("data-table", "Bảng dùng chung"), ("descriptions", "Mô tả"), ("timeline", "Dòng thời gian"), ("prices", "Bảng giá"), ("skeleton", "Khung chờ tải"), ("filters", "Thanh lọc"), ("date-picker", "Bộ chọn ngày"), ("guest-picker", "Số khách"), ("uploads", "Vùng tải file"), ("feedback", "Xác nhận và toast"), ("navigation", "Tabs, đường dẫn, đầu trang"), ("notifications", "Chuông thông báo"), ("booking-search", "Thanh tìm phòng"), ("homestay-cards", "Thẻ homestay"), ("area-cards", "Khu vực"), ("room-options", "Chọn phòng"), ("review-cards", "Thẻ đánh giá"), ("gallery", "Gallery"), ("booking-panel", "Ô báo giá"), ("booking-stepper", "Tiến trình đơn"), ("booking-cards", "Thẻ đơn của khách"), ("rating-input", "Chọn điểm"), ("steps", "Các bước"), ("auth-aside", "Cột ảnh đăng nhập"), ("status-page", "Trang lỗi"), ("payment-qr", "Thanh toán QR"), ("room-calendar", "Lịch tháng"),
    };
    var tokens = new[] { "bg", "surface", "surface-2", "surface-3", "border", "border-strong", "ink", "muted", "primary", "primary-hover",
        "primary-soft", "accent", "accent-hover", "focus", "success", "warning", "danger", "info" };
    var tones = new[] { "sky", "indigo", "violet", "pink", "rose", "orange", "amber", "emerald", "teal", "slate" };
    var statusGroups = new (string Name, Enum[] Values)[]
    {
        ("BookingStatus", Enum.GetValues<BookingStatus>().Cast<Enum>().ToArray()),
        ("ChangeRequestStatus", Enum.GetValues<ChangeRequestStatus>().Cast<Enum>().ToArray()),
        ("HomestayStatus", Enum.GetValues<HomestayStatus>().Cast<Enum>().ToArray()),
        ("OwnerRegistrationStatus", Enum.GetValues<OwnerRegistrationStatus>().Cast<Enum>().ToArray()),
        ("BankMatchStatus", Enum.GetValues<BankMatchStatus>().Cast<Enum>().ToArray()),
        ("VoucherStatus", Enum.GetValues<VoucherStatus>().Cast<Enum>().ToArray()),
        ("ContractStatus", Enum.GetValues<ContractStatus>().Cast<Enum>().ToArray()),
        ("AccountStatus", Enum.GetValues<AccountStatus>().Cast<Enum>().ToArray()),
        ("EmploymentStatus", Enum.GetValues<EmploymentStatus>().Cast<Enum>().ToArray()),
    };
    var sampleRows = new (string Code, string Guest, DateOnly In, DateOnly Out, decimal Total, BookingStatus Status)[]
    {
        ("FJ2611-0012", "Nguyễn Văn Minh", today.AddDays(3), today.AddDays(5), 1_700_000m, BookingStatus.Confirmed),
        ("FJ2611-0013", "Trần Thị Bích Ngọc có tên rất dài để thử xuống dòng", today.AddDays(10), today.AddDays(17), 12_450_000m, BookingStatus.AwaitingPayment),
        ("FJ2611-0014", "Lê Hùng", today.AddDays(-4), today.AddDays(-2), 980_000m, BookingStatus.Completed),
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/layout-public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/dev-uikit.css" asp-append-version="true" />
}

<div class="fx-page-head">
    <div>
        <h1>UI Kit</h1>
        <p class="text-muted mb-0">Mọi component dùng chung, đủ trạng thái. Đổi sáng/tối và VI/EN ở thanh trên để kiểm cả hai chế độ.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="UiKit" asp-route-errors="@(!ViewData.ModelState.IsValid ? null : "true")">
        <icon name="bug" /> @(ViewData.ModelState.IsValid ? "Xem form ở trạng thái lỗi" : "Bỏ trạng thái lỗi")
    </a>
</div>

<nav aria-label="Mục lục UI Kit" class="fx-card p-3 mb-2">
    <ol class="uikit-toc mb-0">
        @foreach (var s in sections)
        {
            <li><a href="#@s.Id">@s.Title</a></li>
        }
    </ol>
</nav>

<section id="colors" class="uikit-section" aria-labelledby="colors-title">
    <h2 id="colors-title" class="fx-section-title">Màu</h2>
    <p class="text-muted">Token <code>--fx-*</code> trong <code>tokens.css</code>. Không viết mã màu ở chỗ khác.</p>
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
        @foreach (var t in tokens)
        {
            <div class="col"><span class="uikit-swatch" data-token="@t"><code>--fx-@t</code></span></div>
        }
    </div>
    <h3 class="h6">Tone trạng thái (<code>.tone-*</code>)</h3>
    <div class="row row-cols-2 row-cols-md-5 g-3">
        @foreach (var t in tones)
        {
            <div class="col"><span class="uikit-swatch tone-@t"><code>tone-@t</code></span></div>
        }
    </div>
</section>

<section id="type" class="uikit-section" aria-labelledby="type-title">
    <h2 id="type-title" class="fx-section-title">Chữ</h2>
    <p class="h1 uikit-display">Tiêu đề h1 – Homestay Tây Hồ</p>
    <p class="h2 uikit-display">Tiêu đề h2 – Phòng đôi hướng hồ</p>
    <p class="h3 uikit-display">Tiêu đề h3 · ỗ ữ ặ ậ ỡ</p>
    <p class="h4">Tiêu đề h4</p>
    <p class="h5">Tiêu đề h5</p>
    <p>Đoạn văn thường: Fuji Homestay kết nối khách với các homestay đã được thẩm định tại Hà Nội. Dấu tiếng Việt: ắ ằ ẳ ẵ ặ ố ồ ổ ỗ ộ ứ ừ ử ữ ự. ỗ ữ ặ ậ ỡ.</p>
    <p class="text-muted">Chữ phụ (<code>--fx-muted</code>) cho mô tả, nhãn phụ.</p>
    <p><span class="booking-code">FJ2611-0012</span> · <span class="price">1.700.000đ</span> · <a href="#type">Link trong đoạn văn</a></p>
</section>

<section id="buttons" class="uikit-section" aria-labelledby="buttons-title">
    <h2 id="buttons-title" class="fx-section-title">Nút</h2>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-brand"><icon name="check2" /> Nút chính</button>
        <button type="button" class="btn btn-accent">Nút nhấn</button>
        <button type="button" class="btn btn-outline-secondary">Nút phụ</button>
        <button type="button" class="btn btn-outline-danger"><icon name="trash3" /> Nút nguy hiểm</button>
        <button type="button" class="btn btn-ghost" aria-label="Nút trong suốt (chỉ icon)"><icon name="three-dots" /></button>
        <button type="button" class="btn btn-brand" disabled>Đã tắt</button>
        <button type="button" class="btn btn-brand btn-sm">Nhỏ</button>
        <button type="button" class="btn btn-brand btn-lg">Lớn</button>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var t in new[] { "sky", "emerald", "rose", "amber", "slate" })
        {
            <button type="button" class="btn btn-icon tone-@t" aria-label="Nút icon tone-@t"><icon name="pencil-square" /></button>
        }
    </div>
    <form class="d-flex gap-2 mb-3" method="get" asp-action="UiKit">
        <button type="submit" class="btn btn-brand" data-loading-text="Đang lưu...">Bấm để xem trạng thái đang xử lý</button>
    </form>
    <div class="uikit-dark-band d-flex gap-2">
        <button type="button" class="btn btn-light-glass">Nút trên nền tối</button>
    </div>
</section>

<section id="badges" class="uikit-section" aria-labelledby="badges-title">
    <h2 id="badges-title" class="fx-section-title">Badge trạng thái</h2>
    <p class="text-muted"><code>&lt;status-badge value="@@x" /&gt;</code> lấy nhãn và tone từ <code>*StatusExtensions</code>. Trạng thái đơn có thêm <code>icon="true"</code>.</p>
    @foreach (var g in statusGroups)
    {
        <h3 class="h6 mt-3"><code>@g.Name</code></h3>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var v in g.Values)
            {
                <status-badge value="v" />
            }
        </div>
        @if (g.Name == "BookingStatus")
        {
            <div class="d-flex flex-wrap gap-2 mt-2">
                @foreach (var v in g.Values)
                {
                    <status-badge value="v" icon="true" />
                }
            </div>
        }
    }
    <h3 class="h6 mt-3">Đối soát và khoản bù (05a)</h3>
    <div class="d-flex flex-wrap gap-2">
        @foreach(var value in Enum.GetValues<SettlementStatus>()) { <status-badge value="value" /> }
        @foreach(var value in Enum.GetValues<PaymentStatus>()) { <status-badge value="value" /> }
    </div>
</section>

<section id="money" class="uikit-section" aria-labelledby="money-title">
    <h2 id="money-title" class="fx-section-title">Tiền và ngày</h2>
    <dl class="row mb-0">
        <dt class="col-sm-4"><code>&lt;money value="0" /&gt;</code></dt><dd class="col-sm-8"><money value="0m" /></dd>
        <dt class="col-sm-4">Số thường</dt><dd class="col-sm-8"><money value="350000m" /></dd>
        <dt class="col-sm-4">Số lớn</dt><dd class="col-sm-8"><money value="125450000m" /></dd>
        <dt class="col-sm-4">Số âm (hoàn tiền)</dt><dd class="col-sm-8"><money value="-150000m" /></dd>
        <dt class="col-sm-4">Không có giá</dt><dd class="col-sm-8"><money value="null" /></dd>
        <dt class="col-sm-4"><code>&lt;date-range /&gt;</code> 1 đêm</dt><dd class="col-sm-8"><date-range from="today" to="today.AddDays(1)" /></dd>
        <dt class="col-sm-4">Nhiều đêm</dt><dd class="col-sm-8"><date-range from="today.AddDays(3)" to="today.AddDays(10)" /></dd>
        <dt class="col-sm-4">Ẩn số đêm</dt><dd class="col-sm-8"><date-range from="today" to="today.AddDays(2)" hide-nights="true" /></dd>
    </dl>
</section>

<section id="icons" class="uikit-section" aria-labelledby="icons-title">
    <h2 id="icons-title" class="fx-section-title">Icon</h2>
    <p class="text-muted"><code>&lt;icon name="calendar" /&gt;</code> ẩn với trình đọc màn hình; có <code>label</code> thì đọc được.</p>
    <div class="d-flex flex-wrap gap-3 fs-4">
        @foreach (var i in new[] { "calendar", "house-heart", "geo-alt", "people", "wifi", "telephone", "bank", "receipt", "star" })
        {
            <icon name="@i" />
        }
        <icon name="info-circle" label="Thông tin thêm" />
    </div>
</section>

<section id="forms" class="uikit-section" aria-labelledby="forms-title">
    <h2 id="forms-title" class="fx-section-title">Form</h2>
    <p class="text-muted"><code>&lt;form-field asp-for="…" /&gt;</code>: label + ô nhập + gợi ý + lỗi. Bấm nút ở đầu trang để xem trạng thái lỗi.</p>
    <form class="fx-card p-4" method="get" asp-action="UiKit" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert tone-rose" role="alert"></div>
        <div class="row">
            <div class="col-md-6"><form-field asp-for="FullName" autocomplete="name" /></div>
            <div class="col-md-6"><form-field asp-for="Phone" type="tel" inputmode="tel" placeholder="09xx xxx xxx" hint="Dùng để tra cứu đơn và nhận tin nhắn." /></div>
            <div class="col-md-6"><form-field asp-for="Email" type="email" /></div>
            <div class="col-md-6"><form-field asp-for="AreaId" type="select" asp-items="Model.Areas" placeholder="— Chọn khu vực —" /></div>
            <div class="col-md-6"><form-field asp-for="Guests" min="1" max="20" /></div>
            <div class="col-md-6"><form-field asp-for="CheckIn" type="date" /></div>
            <div class="col-12"><form-field asp-for="Note" type="textarea" rows="3" hint="Tối đa 500 ký tự." /></div>
            <div class="col-12"><form-field asp-for="Subscribe" /></div>
        </div>
        <button type="submit" class="btn btn-brand" name="errors" value="true">Gửi thử (kiểm tra lỗi)</button>
    </form>
</section>

<section id="alerts" class="uikit-section" aria-labelledby="alerts-title">
    <h2 id="alerts-title" class="fx-section-title">Thông báo</h2>
    <partial name="_Alert" model='new AlertModel("Đã lưu thay đổi.", "success")' />
    <partial name="_Alert" model='new AlertModel("Không lưu được: số điện thoại đã được dùng.", "danger")' />
    <partial name="_Alert" model='new AlertModel("Đơn đang chờ homestay xác nhận, tối đa 30 phút.", "warning")' />
    <partial name="_Alert" model='new AlertModel("Địa chỉ chi tiết hiện sau khi đơn được xác nhận.", "info")' />
</section>

<section id="lists" class="uikit-section" aria-labelledby="lists-title">
    <h2 id="lists-title" class="fx-section-title">Trang danh sách</h2>
    <partial name="_PageHead" model='new PageHeadModel("Đơn đặt phòng", "bi-journal-check", "tone-sky", "Tiêu đề, mô tả và nút chính của trang danh sách.", ShowCreate: false)' />
    <partial name="_FilterBar" model='new FilterBarModel("catalog-filter", new FilterField[] { new("q", "Tìm theo tên", Type: "search") })' />
    <partial name="_DataTable" model='new DataTableModel("Đơn đặt phòng",
        new TableColumn[] { new("Mã đơn", NoWrap: true), new("Khách"), new("Tổng tiền", Numeric: true, NoWrap: true) },
        sampleRows.Select(r => new TableRow(new IHtmlContent[] {
            new HtmlContentBuilder().Append(r.Code), new HtmlContentBuilder().Append(r.Guest), new HtmlContentBuilder().Append(MoneyTagHelper.Format(r.Total))
        })).ToArray(), new PaginatedList<int>(Enumerable.Range(11, 10), 47, 2, 10))' />
</section>

<section id="empty" class="uikit-section" aria-labelledby="empty-title">
    <h2 id="empty-title" class="fx-section-title">Trạng thái rỗng</h2>
    <div class="fx-card"><partial name="_EmptyState" /></div>
</section>

<section id="layout" class="uikit-section" aria-labelledby="layout-title">
    <h2 id="layout-title" class="fx-section-title">Khung trang</h2>
    <ul class="mb-0">
        <li><code>_DashboardLayout</code>: trang này. Sidebar là View Component <code>Sidebar</code> (thu gọn bằng nút trên thanh trên, thành ngăn kéo khi màn &lt; 992px).</li>
        <li><code>_Layout</code>: trang khách, header <code>_SiteHeader</code> (lối vào khu làm việc là View Component <code>WorkspaceSwitcher</code>) và footer <code>_SiteFooter</code>. Xem ở <a asp-controller="Home" asp-action="Index">trang chủ</a>.</li>
        <li><code>_AuthLayout</code>: đăng nhập, đăng ký, trang lỗi. Xem ở <a href="~/Home/StatusCode/404">trang 404</a>.</li>
    </ul>
</section>

<section id="rating" class="uikit-section" aria-labelledby="rating-title">
    <h2 id="rating-title" class="fx-section-title">Điểm đánh giá</h2>
    <div class="d-flex flex-wrap gap-4"><rating value="4.75" count="12" /><rating value="null" count="0" /><rating value="5" count="123456" /><rating value="4" single="true" /></div>
</section>
<section id="stats" class="uikit-section" aria-labelledby="stats-title">
    <h2 id="stats-title" class="fx-section-title">Ô số liệu: thường, trạng thái cần xử lý, số lớn và chữ dài</h2>
    <div class="row g-3">
        <div class="col-md-4"><partial name="_StatCard" model='new StatCardModel("Đơn đặt phòng", "24", "journal-check", Url.Action("Index", "Home"))' /></div>
        <div class="col-md-4"><partial name="_StatCard" model='new StatCardModel("Đơn chờ xác nhận", "0", "hourglass-split", Tone: "tone-amber")' /></div>
        <div class="col-md-4"><partial name="_StatCard" model='new StatCardModel("Số lượng rất lớn và nhãn dài để kiểm tra khả năng xuống dòng trên điện thoại", "999.999.999.999", "graph-up")' /></div>
    </div>
</section>
<section id="data-table" class="uikit-section" aria-labelledby="data-table-title">
    <h2 id="data-table-title" class="fx-section-title">Bảng dữ liệu dùng chung</h2>
    <p class="text-muted">Sắp xếp giữ bộ lọc; ô có nhãn trên điện thoại, mã đơn và số tiền giữ một dòng.</p>
    @{
        var columns = new TableColumn[] { new("Mã đơn", "code", NoWrap: true), new("Khách", "guest"), new("Tổng tiền", "amount", Numeric: true, NoWrap: true) };
        var tableRows = sampleRows.Select(r => new TableRow(new IHtmlContent[] {
            new HtmlContentBuilder().Append(r.Code), new HtmlContentBuilder().Append(r.Guest), new HtmlContentBuilder().Append(MoneyTagHelper.Format(r.Total)),
        })).ToArray();
    }
    <partial name="_DataTable" model='new DataTableModel("Đơn đặt phòng", columns, tableRows, new PaginatedList<int>(Enumerable.Range(11, 10), 47, 2, 10))' />
    <h3 class="h6 mt-4">Bảng rỗng</h3>
    <partial name="_DataTable" model='new DataTableModel("Đơn đặt phòng", columns, Array.Empty<TableRow>())' />
</section>
<section id="descriptions" class="uikit-section" aria-labelledby="descriptions-title">
    <h2 id="descriptions-title" class="fx-section-title">Danh sách mô tả</h2>
    <partial name="_DescriptionList" model='new DescriptionItem[] { new("Homestay", new HtmlContentBuilder().Append("Tên homestay rất dài để kiểm tra việc xuống dòng mà không đẩy rộng màn hình điện thoại")), new("Khách", new HtmlContentBuilder().Append("Nguyễn Văn A <văn bản được encode>")) }' />
</section>
<section id="timeline" class="uikit-section" aria-labelledby="timeline-title">
    <h2 id="timeline-title" class="fx-section-title">Dòng thời gian: lịch sử trạng thái, yêu cầu đổi và rỗng</h2>
    <partial name="_Timeline" model='new TimelineModel(Events: new[] { new TimelineItem(DateTime.UtcNow, "Đã xác nhận", "Chủ homestay đã xác nhận đơn."), new TimelineItem(DateTime.UtcNow.AddMinutes(-30), "Đã đặt cọc", "Ghi chú rất dài để kiểm tra khả năng xuống dòng và văn bản thuần: <script> không được thực thi.") })' />
    <partial name="_Timeline" model='new TimelineModel(Changes: new[] { new ChangeRequestHistoryRow(new BookingChangeRequest { Id = 12, RequestType = ChangeRequestType.ChangeDates, Status = ChangeRequestStatus.Pending, NewCheckIn = today.AddDays(7), NewCheckOut = today.AddDays(9) }, today.AddDays(3), today.AddDays(5), "Phòng đôi", "Phòng đôi") })' />
    <partial name="_Timeline" model="@(new TimelineModel())" />
</section>
<section id="prices" class="uikit-section" aria-labelledby="prices-title">
    <h2 id="prices-title" class="fx-section-title">Bảng giá, hoàn tiền và chính sách hủy</h2>
    <partial name="_PriceBreakdown" model='new PriceBreakdownModel(new[] { new PriceLine("Giá từng đêm", 800000), new PriceLine("Giảm giá", -36000), new PriceLine("Tiền cọc", 600000), new PriceLine("Còn lại", 1400000), new PriceLine("Phí đổi", 300000), new PriceLine("Tiền hoàn khi hủy", 0), new PriceLine("Tổng tiền", 999999999999) })' />
    <partial name="_PriceBreakdown" model='new PriceBreakdownModel(Rules: new[] { new PolicyRuleView(7, 100), new PolicyRuleView(3, 50), new PolicyRuleView(0, 0) })' />
    <div class="mt-4"><partial name="_EmptyState" model='new EmptyStateModel("Không có dữ liệu.", "Chọn ngày để xem báo giá.", "calendar")' /></div>
    <div class="mt-4"><partial name="_EmptyState" model='new EmptyStateModel("Đã xảy ra lỗi", "Vui lòng thử lại sau hoặc liên hệ Fuji để được hỗ trợ.", "exclamation-triangle", "Về trang chủ", Url.Action("Index", "Home"))' /></div>
</section>
<section id="skeleton" class="uikit-section" aria-labelledby="skeleton-title">
    <h2 id="skeleton-title" class="fx-section-title">Khung chờ tải: dòng và thẻ, tôn trọng reduced-motion</h2>
    <partial name="_Skeleton" model="@(new SkeletonModel())" />
    <div class="mt-4"><partial name="_Skeleton" model="@(new SkeletonModel(Cards: true))" /></div>
</section>

<section id="filters" class="uikit-section" aria-labelledby="filters-title">
    <h2 id="filters-title" class="fx-section-title">Thanh lọc: GET, giữ query, ngăn kéo trên điện thoại</h2>
    <partial name="_FilterBar" model='new FilterBarModel("kit-filter", new[] { new FilterField("Q", "Từ khóa"), new FilterField("Guests", "Số khách", "2", "number"), new FilterField("AreaId", "Khu vực", Options: Model.Areas), new FilterField("AmenityIds", "Tiện nghi", Type: "checkbox", Options: new[] { new SelectListItem("Wifi", "1", true), new SelectListItem("Điều hòa", "2"), new SelectListItem("Bếp riêng", "3"), new SelectListItem("Cho phép thú cưng", "4") }) })' />
</section>
<section id="date-picker" class="uikit-section" aria-labelledby="date-picker-title">
    <h2 id="date-picker-title" class="fx-section-title">Ngày theo đêm: thường, rỗng, lỗi, đang tải</h2>
    <div class="row g-4">
